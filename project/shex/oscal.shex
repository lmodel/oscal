          <description> @<MarkupMultilineType> ? ;
          <include_all> @<IncludeAll> ? ;
          <include_objectives> @<SelectObjectiveById> * ;
          <exclude_objectives> @<SelectObjectiveById> * ;
          <remarks> @<MarkupMultilineType> ? ;
          <props> @<Property> * ;
          <links> @<Link> *
       ) ;
       rdf:type [ <ControlObjectiveSelection> ] ?
    )
}

