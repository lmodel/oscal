          rdf:type [ <HasResponsibleRoles> ] ? ;
          <uuid> @<UUIDType> ;
          <type> @linkml:String ;
          <title> @<MarkupLineType> ;
          <description> @<MarkupMultilineType> ;
          <purpose> @<MarkupLineType> ? ;
          <protocols> @<Protocol> * ;
