    (  $<Facet_tes> (  &<OscalCommon_tes> ;
          rdf:type [ <OscalCommon> ] ? ;
          <name> @<TokenType> ;
          <value> @linkml:String ;
          <system> @<URIType> ;
          <remarks> @<MarkupMultilineType> ? ;
          <props> @<Property> * ;
          <links> @<Link> *
