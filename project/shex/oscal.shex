          <uuid> @<UUIDType> ;
          <source> @<URIReferenceType> ;
          <description> @<MarkupMultilineType> ;
          <set_parameters> @<SetParameter> * ;
          <implemented_requirements> @<ImplementedRequirement> + ;
          <props> @<Property> * ;
          <links> @<Link> *
       ) ;
       rdf:type [ <ControlImplementationSet> ] ?
    )
}

<ControlMatching> CLOSED {
