<https://w3id.org/lmodel/oscal/DateTimeWithTimezoneType> a linkml:TypeDefinition ;
    skos:inScheme "https://w3id.org/lmodel/oscal_catalog"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/lmodel/oscal_catalog/DateTimeWithTimezoneType"^^xsd:anyURI ;
    linkml:description "A string representing a point in time with a required timezone." ;
    linkml:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .

