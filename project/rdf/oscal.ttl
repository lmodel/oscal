            dcterms:title "addresses-xor-location-uuids" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/oscal/addresses> ] ;
            linkml:description "A party may have inline addresses or location UUID references, but not both (metaschema <choice> constraint)." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/oscal/location_uuids> ] ],
        [ a linkml:ClassRule ;
            dcterms:title "location-uuids-xor-addresses" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/oscal/location_uuids> ] ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/oscal/addresses> ] ] ;
    linkml:class_uri "https://w3id.org/lmodel/oscal_catalog/Party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/oscal_catalog/Party"^^xsd:anyURI ;
