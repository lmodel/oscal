<https://w3id.org/lmodel/oscal/Parameter> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/oscal/oscal_control_common> ;
    skos:inScheme "https://w3id.org/lmodel/oscal_catalog"^^xsd:anyURI ;
    sh:rule [ a linkml:ClassRule ;
            dcterms:title "select-xor-values" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/oscal/select> ] ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/oscal/values> ] ],
        [ a linkml:ClassRule ;
            dcterms:title "values-xor-select" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/oscal/values> ] ;
            linkml:description "A parameter may have prescribed values or a selection construct, but not both (metaschema <choice> constraint)." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/oscal/select> ] ] ;
    linkml:class_uri "https://w3id.org/lmodel/oscal_catalog/Parameter"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/oscal_catalog/Parameter"^^xsd:anyURI ;
    linkml:description "Parameters provide a mechanism for the dynamic assignment of value(s) in a control." ;
    linkml:mixins <https://w3id.org/lmodel/oscal/OscalCommon> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/oscal/Parameter__class>,
        <https://w3id.org/lmodel/oscal/Parameter_id>,
        <https://w3id.org/lmodel/oscal/Parameter_props>,
        <https://w3id.org/lmodel/oscal/constraints>,
        <https://w3id.org/lmodel/oscal/depends_on>,
        <https://w3id.org/lmodel/oscal/guidelines>,
        <https://w3id.org/lmodel/oscal/label>,
        <https://w3id.org/lmodel/oscal/links>,
        <https://w3id.org/lmodel/oscal/remarks>,
        <https://w3id.org/lmodel/oscal/select>,
        <https://w3id.org/lmodel/oscal/usage>,
        <https://w3id.org/lmodel/oscal/values> .

