@startuml
skinparam nodesep 10
hide circle
hide empty members
class "EventTiming" [[{The timing under which the task is intended to occur.}]] {

}
class "WithinDateRange" [[{The task is intended to occur within the specified date range.}]] {
    {field} start : DateTimeWithTimezoneType  
    {field} end : DateTimeWithTimezoneType  
    {field} remarks : MarkupMultilineType  
}
"EventTiming" *--> "0..1" "WithinDateRange" : "within-date-range"
class "AssessmentPlatform" [[{Used to represent the toolset used to perform aspects of the assessment.}]] {
    {field} uuid : UUIDType  
    {field} title : MarkupLineType  
    {field} remarks : MarkupMultilineType  
}
class "UsesComponent" [[{The set of components that are used by the assessment platform.}]] {
    {field} component_uuid : UUIDType  
    {field} remarks : MarkupMultilineType  
}
class "OscalCommon" [[{Mixin providing props, links, and remarks slots common to most OSCAL objects. Extends HasPropsAndLinks.}]] {
    {field} remarks : MarkupMultilineType  
}
class "HasResponsibleParties" [[{Mixin providing the responsible-parties slot for objects that carry party assignments.}]] {

}
"AssessmentPlatform" *--> "0..*" "UsesComponent" : "uses-components"
"OscalCommon" ^.. "UsesComponent"
"HasResponsibleParties" ^.. "UsesComponent"
class "Risk" [[{An identified risk.}]] {
    {field} uuid : UUIDType  
    {field} title : MarkupLineType  
    {field} description : MarkupMultilineType  
    {field} statement : MarkupMultilineType  
    {field} deadline : DateTimeWithTimezoneType  
    {field} status : string  
}
class "ThreatId" [[{A pointer, by ID, to an externally-defined threat.}]] {
    {field} href : URIReferenceType  
    {field} system : URIType  
    {field} id : URIType  
}
"Risk" *--> "0..*" "ThreatId" : "threat-ids"
class "TermsAndConditions" [[{Used to define various terms and conditions under which an assessment can be performed.}]] {

}
class "TermsAndConditionsPart" [[{A terms-and-conditions scoped assessment part.}]] {
    {field} name : TermsAndConditionsPartNameEnum  
    {field} uuid(i) : UUIDType  
    {field} ns(i) : URIType  
    {field} _class(i) : TokenType  
    {field} title(i) : MarkupLineType  
    {field} prose(i) : MarkupMultilineType  
}
class "AssessmentPlan" [[{An assessment plan, such as those provided by a FedRAMP assessor.}]] {
    {field} uuid : UUIDType  
}
"TermsAndConditions" *--> "0..*" "TermsAndConditionsPart" : "parts"
"AssessmentPlan" *--> "0..1" "TermsAndConditions" : "terms-and-conditions"
class "AssessmentPart" [[{A partition of an assessment plan or results or a child of another part.}]] {
    {field} uuid : UUIDType  
    {field} name : TokenType  
    {field} ns : URIType  
    {field} _class : TokenType  
    {field} title : MarkupLineType  
    {field} prose : MarkupMultilineType  
}
"TermsAndConditionsPart" *--> "0..*" "TermsAndConditionsPart" : "parts"
"AssessmentPart" ^-- "TermsAndConditionsPart"
class "Location" [[{A physical point of presence, which may be associated with people, organizations, or other concepts within the current or linked OSCAL document.}]] {
    {field} uuid : UUIDType  
    {field} title : MarkupLineType  
    {field} email_addresses : EmailAddressType  [0..*]
    {field} urls : URIType  [0..*]
    {field} remarks : MarkupMultilineType  
}
class "TelephoneNumber" [[{A telephone service number as defined by ITU-T E.164.}]] {
    {field} type : string  
    {field} number : string  
}
class "Party" [[{An organization or person, which may be associated with roles or other concepts within the current or linked OSCAL document.}]] {
    {field} uuid : UUIDType  
    {field} type : PartyTypeEnum  
    {field} name : string  
    {field} short_name : string  
    {field} email_addresses : EmailAddressType  [0..*]
    {field} location_uuids : UUIDType  [0..*]
    {field} member_of_organizations : UUIDType  [0..*]
    {field} remarks : MarkupMultilineType  
}
"Location" *--> "0..*" "TelephoneNumber" : "telephone-numbers"
"Party" *--> "0..*" "TelephoneNumber" : "telephone-numbers"
class "Task" [[{Represents a scheduled event or milestone, which may be associated with a series of assessment actions.}]] {
    {field} uuid : UUIDType  
    {field} type : string  
    {field} title : MarkupLineType  
    {field} description : MarkupMultilineType  
    {field} remarks : MarkupMultilineType  
}
class "TaskDependency" [[{Used to indicate that a task is dependent on another task.}]] {
    {field} task_uuid : UUIDType  
    {field} remarks : MarkupMultilineType  
}
"Task" *--> "0..*" "TaskDependency" : "dependencies"
class "AssessmentSubject" [[{Identifies system elements being assessed, such as components, inventory items, and locations.}]] {
    {field} type : string  
    {field} description : MarkupMultilineType  
    {field} remarks : MarkupMultilineType  
}
class "AssociatedActivity" [[{Identifies an individual activity to be performed as part of a task.}]] {
    {field} activity_uuid : UUIDType  
    {field} remarks : MarkupMultilineType  
}
class "HasResponsibleRoles" [[{Mixin providing the responsible-roles slot for objects that carry role assignments.}]] {

}
"Task" *--> "0..*" "AssessmentSubject" : "subjects"
"Task" *--> "0..*" "Task" : "tasks"
"Task" *--> "0..*" "AssociatedActivity" : "associated-activities"
"Task" *--> "0..1" "EventTiming" : "timing"
"OscalCommon" ^.. "Task"
"HasResponsibleRoles" ^.. "Task"
class "SystemUser" [[{A type of user that interacts with the system based on an associated role.}]] {
    {field} uuid : UUIDType  
    {field} title : MarkupLineType  
    {field} short_name : string  
    {field} description : MarkupMultilineType  
    {field} role_ids : TokenType  [0..*]
    {field} remarks : MarkupMultilineType  
}
class "ImplementationCommonLink" [[{Implementation-common scoped OSCAL link.}]] {
    {field} rel : TokenType  
    {field} href(i) : URIReferenceType  
    {field} resource_fragment(i) : string  
    {field} media_type(i) : string  
    {field} text(i) : MarkupLineType  
}
class "ImplementationCommonProperty" [[{Implementation-common scoped OSCAL property.}]] {
    {field} name : ImplementationPropNameEnum  
    {field} value : string  
    {field} uuid(i) : UUIDType  
    {field} ns(i) : URIType  
    {field} _class(i) : TokenType  
    {field} remarks(i) : MarkupMultilineType  
    {field} group(i) : TokenType  
}
class "AuthorizedPrivilege" [[{Identifies a specific system privilege held by the user, along with an associated description and/or rationale for the privilege.}]] {
    {field} title : MarkupLineType  
    {field} description : MarkupMultilineType  
    {field} functions_performed : string  [1..*]
}
class "SystemImplementation" [[{Provides information as to how the system is implemented.}]] {
    {field} remarks : MarkupMultilineType  
}
class "LocalDefinitions" [[{Used to define data objects that are used in the assessment plan, that do not appear in the referenced SSP.}]] {
    {field} remarks : MarkupMultilineType  
}
class "ResultLocalDefinitions" [[{Used to define local implementation and assessment assets referenced by a result that do not appear in the imported system security plan.}]] {

}
"SystemUser" *--> "0..*" "ImplementationCommonLink" : "links"
"SystemUser" *--> "0..*" "ImplementationCommonProperty" : "props"
"SystemUser" *--> "0..*" "AuthorizedPrivilege" : "authorized-privileges"
"SystemImplementation" *--> "0..*" "SystemUser" : "users"
"LocalDefinitions" *--> "0..*" "SystemUser" : "users"
"ResultLocalDefinitions" *--> "0..*" "SystemUser" : "users"
"OscalCommon" ^.. "SystemUser"
class "SystemCharacteristics" [[{Contains the characteristics of the system, such as its name, purpose, and security impact level.}]] {
    {field} system_name : string  
    {field} system_name_short : string  
    {field} description : MarkupMultilineType  
    {field} date_authorized : string  
    {field} security_sensitivity_level : string  
    {field} remarks : MarkupMultilineType  
}
class "SystemStatus" [[{Describes the operational status of the system.}]] {
    {field} remarks : MarkupMultilineType  
    {field} state : SystemOperatingStatusEnum  
}
"SystemCharacteristics" *--> "1" "SystemStatus" : "system-status"
"SystemCharacteristics" *--> "0..1" "SystemStatus" : "system-status"(i)
class "SystemSecurityPlan" [[{A system security plan, such as those described in NIST SP 800-18.}]] {
    {field} uuid : UUIDType  
}
class "BackMatter" [[{A collection of resources that may be referenced from within the OSCAL document instance.}]] {

}
class "SspControlImplementation" [[{Describes how the system satisfies a set of controls.}]] {
    {field} description : MarkupMultilineType  
}
class "ImportProfile" [[{Used to import the OSCAL profile representing the system's control baseline.}]] {
    {field} href : URIReferenceType  
    {field} remarks : MarkupMultilineType  
}
class "Metadata" [[{Provides information about the containing document, and defines concepts shared across the document.}]] {
    {field} title : MarkupLineType  
    {field} published : DateTimeWithTimezoneType  
    {field} last_modified : DateTimeWithTimezoneType  
    {field} version : string  
    {field} oscal_version : string  
    {field} remarks : MarkupMultilineType  
}
class "SspDocument" [[{Root wrapper for an OSCAL System Security Plan document.}]] {

}
"SystemSecurityPlan" *--> "0..1" "BackMatter" : "back-matter"
"SystemSecurityPlan" *--> "1" "SspControlImplementation" : "control-implementation"
"SystemSecurityPlan" *--> "1" "SystemImplementation" : "system-implementation"
"SystemSecurityPlan" *--> "1" "SystemCharacteristics" : "system-characteristics"
"SystemSecurityPlan" *--> "1" "ImportProfile" : "import-profile"
"SystemSecurityPlan" *--> "1" "Metadata" : "metadata"
"SspDocument" *--> "1" "SystemSecurityPlan" : "system-security-plan"
"SspDocument" *--> "0..1" "SystemSecurityPlan" : "system-security-plan"(i)
class "SystemInformation" [[{Contains details about all information types that are stored, processed, or transmitted by the system, such as privacy information.}]] {

}
class "InformationType" [[{Contains details about one information type that is stored, processed, or transmitted by the system, such as privacy information, and its impact level.}]] {
    {field} uuid : UUIDType  
    {field} title : MarkupLineType  
    {field} description : MarkupMultilineType  
}
class "SspSystemInformationLink" [[{SSP-scoped link used in system information.}]] {
    {field} rel : TokenType  
    {field} href(i) : URIReferenceType  
    {field} resource_fragment(i) : string  
    {field} media_type(i) : string  
    {field} text(i) : MarkupLineType  
}
class "SspSystemInformationProp" [[{SSP-scoped property used in system information.}]] {
    {field} name : SystemInformationPropNameEnum  
    {field} value : PrivacyDesignationEnum  
    {field} uuid(i) : UUIDType  
    {field} ns(i) : URIType  
    {field} _class(i) : TokenType  
    {field} remarks(i) : MarkupMultilineType  
    {field} group(i) : TokenType  
}
"SystemInformation" *--> "1..*" "InformationType" : "information-types"
"SystemInformation" *--> "0..*" "SspSystemInformationLink" : "links"
"SystemInformation" *--> "0..*" "SspSystemInformationProp" : "props"
"SystemCharacteristics" *--> "1" "SystemInformation" : "system-information"
"SystemCharacteristics" *--> "0..1" "SystemInformation" : "system-information"(i)
class "SspInventoryItem" [[{SSP-scoped inventory item with allows-authenticated-scan property typing.}]] {
    {field} uuid(i) : UUIDType  
    {field} description(i) : MarkupMultilineType  
    {field} remarks(i) : MarkupMultilineType  
}
class "SspSystemComponent" [[{SSP-scoped system component with allows-authenticated-scan property typing.}]] {
    {field} uuid(i) : UUIDType  
    {field} type(i) : string  
    {field} title(i) : MarkupLineType  
    {field} description(i) : MarkupMultilineType  
    {field} purpose(i) : MarkupLineType  
    {field} remarks(i) : MarkupMultilineType  
}
class "LeveragedAuthorization" [[{A description of another authorized system from which this system inherits capabilities that satisfy security requirements. Another term for this concept is a common control provider.}]] {
    {field} uuid : UUIDType  
    {field} title : MarkupLineType  
    {field} party_uuid : UUIDType  
    {field} date_authorized : string  
    {field} remarks : MarkupMultilineType  
}
class "Link" [[{A reference to a local or remote resource, that has a specific relation to the containing object.}]] {
    {field} href : URIReferenceType  
    {field} rel : TokenType  
    {field} resource_fragment : string  
    {field} media_type : string  
    {field} text : MarkupLineType  
}
class "Property" [[{An attribute, characteristic, or quality of the containing object expressed as a namespace qualified name/value pair.}]] {
    {field} name : TokenType  
    {field} uuid : UUIDType  
    {field} ns : URIType  
    {field} value : string  
    {field} _class : TokenType  
    {field} remarks : MarkupMultilineType  
    {field} group : TokenType  
}
"SystemImplementation" *--> "0..*" "SspInventoryItem" : "inventory-items"
"SystemImplementation" *--> "1..*" "SspSystemComponent" : "components"
"SystemImplementation" *--> "0..*" "LeveragedAuthorization" : "leveraged-authorizations"
"SystemImplementation" *--> "0..*" "Link" : "links"
"SystemImplementation" *--> "0..*" "Property" : "props"
"SystemSecurityPlan" *--> "0..1" "SystemImplementation" : "system-implementation"(i)
class "SystemId" [[{A human-oriented, globally unique identifier for a system.}]] {
    {field} id : string  
    {field} identifier_type : string  
}
class "PlanOfActionAndMilestones" [[{A plan of action and milestones that identifies initial and residual risks, deviations, and disposition.}]] {
    {field} uuid : UUIDType  
}
"SystemCharacteristics" *--> "1..*" "SystemId" : "system-ids"
"PlanOfActionAndMilestones" *--> "0..1" "SystemId" : "system-id"
"SystemCharacteristics" *--> "0..*" "SystemId" : "system-ids"(i)
class "SystemComponent" [[{A defined component that can be part of an implemented system.}]] {
    {field} uuid : UUIDType  
    {field} type : string  
    {field} title : MarkupLineType  
    {field} description : MarkupMultilineType  
    {field} purpose : MarkupLineType  
    {field} remarks : MarkupMultilineType  
}
class "ImplementationResponsibleRole" [[{Implementation-common scoped responsible role.}]] {
    {field} role_id : TokenType  
    {field} party_uuids(i) : UUIDType  [0..*]
    {field} remarks(i) : MarkupMultilineType  
}
class "ComponentStatus" [[{Describes the operational status of the system component.}]] {
    {field} state : ComponentStateEnum  
    {field} remarks : MarkupMultilineType  
}
class "Protocol" [[{Information about the protocol used to provide a service.}]] {
    {field} uuid : UUIDType  
    {field} name : string  
    {field} title : MarkupLineType  
}
class "AssessmentAssets" [[{Identifies the assets used to perform this assessment.}]] {

}
class "ComponentDefinition" [[{A collection of component descriptions, which may optionally be grouped by capability.}]] {
    {field} uuid : UUIDType  
}
class "PoamLocalDefinitions" [[{Allows components and inventory items to be defined within the POA&M for cases where no OSCAL SSP is available with the POA&M.}]] {
    {field} remarks : MarkupMultilineType  
}
"SystemComponent" *--> "0..*" "ImplementationResponsibleRole" : "responsible-roles"
"SystemComponent" *--> "0..*" "ImplementationCommonLink" : "links"
"SystemComponent" *--> "0..*" "ImplementationCommonProperty" : "props"
"SystemComponent" *--> "1" "ComponentStatus" : "status"
"SystemComponent" *--> "0..*" "Protocol" : "protocols"
"SystemImplementation" *--> "0..*" "SystemComponent" : "components"(i)
"LocalDefinitions" *--> "0..*" "SystemComponent" : "components"
"AssessmentAssets" *--> "0..*" "SystemComponent" : "components"
"ResultLocalDefinitions" *--> "0..*" "SystemComponent" : "components"
"ComponentDefinition" *--> "0..*" "SystemComponent" : "components"(i)
"PoamLocalDefinitions" *--> "0..*" "SystemComponent" : "components"
"OscalCommon" ^.. "SystemComponent"
"HasResponsibleRoles" ^.. "SystemComponent"
"SystemComponent" ^-- "SspSystemComponent"
class "SspSystemCharacteristicsProp" [[{SSP-scoped property used in system characteristics.}]] {
    {field} name : SystemCharacteristicsPropNameEnum  
    {field} value : string  
    {field} uuid(i) : UUIDType  
    {field} ns(i) : URIType  
