    {field} role_id : TokenType  
    {field} party_uuids(i) : UUIDType  [1..*]
    {field} remarks(i) : MarkupMultilineType  
}
class "DataFlow" [[{A description of the logical flow of information within the system and across its boundaries, optionally supplemented with diagrams.}]] {
    {field} description : MarkupMultilineType  
    {field} remarks : MarkupMultilineType  
}
class "NetworkArchitecture" [[{A description of the system's network architecture, optionally supplemented with diagrams that illustrate the network architecture.}]] {
    {field} description : MarkupMultilineType  
    {field} remarks : MarkupMultilineType  
}
class "AuthorizationBoundary" [[{A description of this system's authorization boundary, optionally supplemented with diagrams that illustrate the authorization boundary.}]] {
    {field} description : MarkupMultilineType  
    {field} remarks : MarkupMultilineType  
}
class "SecurityImpactLevel" [[{The overall level of expected impact resulting from unauthorized disclosure, modification, or loss of access to information.}]] {
    {field} security_objective_confidentiality : string  
    {field} security_objective_integrity : string  
    {field} security_objective_availability : string  
}
"SystemCharacteristics" *--> "0..*" "SspSystemCharacteristicsProp" : "props"
"SystemCharacteristics" *--> "0..*" "SspSystemCharacteristicsResponsibleParty" : "responsible-parties"
"SystemCharacteristics" *--> "0..1" "DataFlow" : "data-flow"
"SystemCharacteristics" *--> "0..1" "NetworkArchitecture" : "network-architecture"
"SystemCharacteristics" *--> "1" "AuthorizationBoundary" : "authorization-boundary"
