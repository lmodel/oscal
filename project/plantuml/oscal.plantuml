class "MitigatingFactor" [[{Describes an existing mitigating factor that may affect the overall determination of the risk.}]] {
    {field} uuid : UUIDType  
    {field} description : MarkupMultilineType  
    {field} implementation_uuid : UUIDType  
}
class "SubjectReference" [[{A human-oriented identifier reference to a resource. Use type to indicate whether the identified resource is a component, inventory item, location, user, or something else.}]] {
    {field} subject_uuid : UUIDType  
    {field} type : string  
    {field} title : MarkupLineType  
    {field} remarks : MarkupMultilineType  
}
