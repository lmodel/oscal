"AuthorizationBoundary" *--> "0..*" "Diagram" : "diagrams"
"DataFlow" *--> "0..*" "Diagram" : "diagrams"
"DefinedComponent" *--> "0..*" "ControlImplementationSet" : "control-implementations"
"ComponentDefinition" *--> "0..*" "DefinedComponent" : "components"
class "AssessmentSelectControlById" [[{Select a specific control for inclusion/exclusion in the assessment by literal control ID and optional statement IDs.}]] {
    {field} control_id : TokenType  
    {field} statement_ids : TokenType  [0..*]
}
"ControlSelection" *--> "0..*" "AssessmentSelectControlById" : "exclude-controls"
"ControlSelection" *--> "0..*" "AssessmentSelectControlById" : "include-controls"
"ReviewedControls" *--> "0..*" "ControlSelection" : "control-selections"(i)
"ControlPart" *--> "0..*" "ControlPart" : "parts"
"Capability" *--> "0..*" "ControlImplementationSet" : "control-implementations"
"Control" *--> "0..*" "Control" : "controls"
"ComponentDefinitionDocument" *--> "1" "ComponentDefinition" : "component-definition"
"ComponentDefinition" *--> "0..1" "BackMatter" : "back-matter"
"ComponentDefinition" *--> "0..*" "Capability" : "capabilities"
"ComponentDefinitionDocument" *--> "0..1" "ComponentDefinition" : "component-definition"(i)
"CatalogDocument" *--> "1" "Catalog" : "catalog"
"Catalog" *--> "0..1" "BackMatter" : "back-matter"
"CatalogDocument" *--> "0..1" "Catalog" : "catalog"(i)
"AssessmentPlan" *--> "0..1" "BackMatter" : "back-matter"
"AssessmentResults" *--> "0..1" "BackMatter" : "back-matter"
"SystemCharacteristics" *--> "0..1" "AuthorizationBoundary" : "authorization-boundary"(i)
"Attestation" *--> "1..*" "AssessmentPart" : "parts"
"AssociatedActivity" *--> "1..*" "AssessmentSubject" : "subjects"
class "AssessmentSubjectSource" [[{Assessment subjects will be identified while conducting the referenced activity.}]] {
    {field} task_uuid : UUIDType  
    {field} remarks : MarkupMultilineType  
}
"AssessmentSubjectPlaceholder" *--> "1..*" "AssessmentSubjectSource" : "sources"
"AssessmentPlan" *--> "0..*" "AssessmentSubject" : "assessment-subjects"
"AssessmentResultsLocalDefinitions" *--> "0..*" "Activity" : "activities"
"AssessmentResults" *--> "0..1" "AssessmentResultsLocalDefinitions" : "local-definitions"
"AssessmentResultsDocument" *--> "1" "AssessmentResults" : "assessment-results"
"AssessmentResultsDocument" *--> "0..1" "AssessmentResults" : "assessment-results"(i)
"AssessmentAssets" *--> "1..*" "AssessmentPlatform" : "assessment-platforms"
"AssessmentAssets" *--> "0..*" "AssessmentPlatform" : "assessment-platforms"(i)
"AssessmentPlanDocument" *--> "1" "AssessmentPlan" : "assessment-plan"
"AssessmentPlan" *--> "0..1" "AssessmentAssets" : "assessment-assets"
"AssessmentPlanDocument" *--> "0..1" "AssessmentPlan" : "assessment-plan"(i)
"AssessmentPart" *--> "0..*" "AssessmentPart" : "parts"
"AssessmentMethod" *--> "1" "AssessmentPart" : "part"
"AssessmentMethod" *--> "0..1" "AssessmentPart" : "part"(i)
"AssessmentLog" *--> "1..*" "AssessmentLogEntry" : "entries"
"Result" *--> "0..1" "AssessmentLog" : "assessment-log"(i)
"Alteration" *--> "0..*" "Addition" : "adds"
@enduml
