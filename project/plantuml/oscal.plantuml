    {field} uuid : UUIDType  
    {field} title : MarkupLineType  
    {field} description : MarkupMultilineType  
    {field} methods : string  [1..*]
    {field} types : string  [0..*]
    {field} collected : DateTimeWithTimezoneType  
    {field} expires : DateTimeWithTimezoneType  
    {field} remarks : MarkupMultilineType  
}
class "RequiredAsset" [[{Identifies an asset required to achieve remediation.}]] {
    {field} uuid : UUIDType  
    {field} title : MarkupLineType  
    {field} description : MarkupMultilineType  
    {field} remarks : MarkupMultilineType  
}
"MitigatingFactor" *--> "0..*" "SubjectReference" : "subjects"
"Observation" *--> "0..*" "SubjectReference" : "subjects"
"RequiredAsset" *--> "0..*" "SubjectReference" : "subjects"
