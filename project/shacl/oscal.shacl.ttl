@prefix oscal: <https://w3id.org/lmodel/oscal/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oscal:AssessmentMethod a sh:NodeShape ;
    rdfs:comment "A local definition of a control objective." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:class oscal:AssessmentPart ;
            sh:description "An assessment part." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:part ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:AssessmentMethod .

oscal:AssessmentPlanDocument a sh:NodeShape ;
    rdfs:comment "Root wrapper for an OSCAL Assessment Plan document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:AssessmentPlan ;
            sh:description "The root assessment plan object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:assessment_plan ] ;
    sh:targetClass oscal:AssessmentPlanDocument .

oscal:AssessmentResultsDocument a sh:NodeShape ;
    rdfs:comment "Root wrapper for an OSCAL Assessment Results document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:AssessmentResults ;
            sh:description "The root assessment results object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:assessment_results ] ;
    sh:targetClass oscal:AssessmentResultsDocument .

oscal:AssessmentSubjectPlaceholder a sh:NodeShape ;
    rdfs:comment "Used when the assessment subjects will be determined as part of one or more other assessment activities." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:class oscal:AssessmentSubjectSource ;
            sh:description "Source references or source-participation entries in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:sources ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:AssessmentSubjectPlaceholder .

oscal:CatalogDocument a sh:NodeShape ;
    rdfs:comment "Root wrapper for an OSCAL Catalog document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Catalog ;
            sh:description "Root catalog document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:catalog ] ;
    sh:targetClass oscal:CatalogDocument .

oscal:ComponentDefinitionDocument a sh:NodeShape ;
    rdfs:comment "Root wrapper for an OSCAL Component Definition document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ComponentDefinition ;
            sh:description "The root component-definition object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:component_definition ] ;
    sh:targetClass oscal:ComponentDefinitionDocument .

oscal:HasPropsAndLinks a sh:NodeShape ;
    rdfs:comment "Mixin providing the props and links slots that are common to many OSCAL objects." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:props ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:HasPropsAndLinks .

oscal:HasResponsibleParties a sh:NodeShape ;
    rdfs:comment "Mixin providing the responsible-parties slot for objects that carry party assignments." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ResponsibleParty ;
            sh:description "Responsible party assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:responsible_parties ] ;
    sh:targetClass oscal:HasResponsibleParties .

oscal:HasResponsibleRoles a sh:NodeShape ;
    rdfs:comment "Mixin providing the responsible-roles slot for objects that carry role assignments." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:responsible_roles ] ;
    sh:targetClass oscal:HasResponsibleRoles .

oscal:MappingCollectionDocument a sh:NodeShape ;
    rdfs:comment "Root wrapper for an OSCAL Mapping Collection document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:MappingCollection ;
            sh:description "The root mapping collection object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:mapping_collection ] ;
    sh:targetClass oscal:MappingCollectionDocument .

oscal:OscalCommon a sh:NodeShape ;
    rdfs:comment "Mixin providing props, links, and remarks slots common to most OSCAL objects. Extends HasPropsAndLinks." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:OscalCommon .

oscal:OscalDocument a sh:NodeShape ;
    rdfs:comment "A root wrapper for an OSCAL document, which may be of any OSCAL document type (e.g. Catalog, Profile, Assessment Plan, SSP)." ;
    sh:closed true ;
    sh:ignoredProperties ( oscal:plan_of_action_and_milestones rdf:type oscal:system_security_plan oscal:mapping_collection oscal:profile oscal:assessment_results oscal:component_definition oscal:assessment_plan oscal:catalog ) ;
    sh:targetClass oscal:OscalDocument .

oscal:PartyExternalId a sh:NodeShape ;
    rdfs:comment "An identifier for a person or organization using a designated scheme, e.g. an Open Researcher and Contributor ID (ORCID)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A unique human-oriented identifier within a particular context." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:id ],
        [ sh:description "Indicates the type of external identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "http://orcid.org/" ) ] [ sh:nodeKind sh:IRI ] ) ;
            sh:order 0 ;
            sh:path oscal:scheme ] ;
    sh:targetClass oscal:PartyExternalId .

oscal:PoamDocument a sh:NodeShape ;
    rdfs:comment "Root wrapper for an OSCAL Plan of Action and Milestones document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:PlanOfActionAndMilestones ;
            sh:description "The root plan of action and milestones object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:plan_of_action_and_milestones ] ;
    sh:targetClass oscal:PoamDocument .

oscal:ProfileDocument a sh:NodeShape ;
    rdfs:comment "Root wrapper for an OSCAL Profile document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Profile ;
            sh:description "The root profile object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:profile ] ;
    sh:targetClass oscal:ProfileDocument .

oscal:SspDocument a sh:NodeShape ;
    rdfs:comment "Root wrapper for an OSCAL System Security Plan document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SystemSecurityPlan ;
            sh:description "A system security plan, such as those described in NIST SP 800-18." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:system_security_plan ] ;
    sh:targetClass oscal:SspDocument .

oscal:Action a sh:NodeShape ;
    rdfs:comment "An action applied by a role within a given party to the content." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Specifies the action type system used." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "http://csrc.nist.gov/ns/oscal" ) ] [ sh:nodeKind sh:IRI ] ) ;
            sh:order 3 ;
            sh:path oscal:system ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time when the action occurred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:date ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:class oscal:ResponsibleParty ;
            sh:description "Responsible party assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:responsible_parties ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier that can be used to reference this defined action elsewhere in an OSCAL document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:props ],
        [ sh:description "The type of action documented by the assembly, such as an approval." ;
            sh:in ( "approval" "request-changes" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path oscal:type ] ;
    sh:targetClass oscal:Action .

oscal:Addition a sh:NodeShape ;
    rdfs:comment "Specifies content to be added into controls in resolution." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:description "Where to add new content relative to the targeted element." ;
            sh:in ( "before" "after" "starting" "ending" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path oscal:position ],
        [ sh:class oscal:ProfileAlterationProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "Identify or target items by their id value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:by_id ],
        [ sh:class oscal:Part ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:parts ],
        [ sh:class oscal:Parameter ;
            sh:description "Parameters providing a mechanism for the dynamic assignment of value(s) in a control." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:params ] ;
    sh:targetClass oscal:Addition .

oscal:Alteration a sh:NodeShape ;
    rdfs:comment "Specifies changes to be made to an included control when a profile is resolved." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A reference to a control by its identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:control_id ],
        [ sh:class oscal:Addition ;
            sh:description "Specifies content to be added into a control in resolution." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:adds ],
        [ sh:class oscal:Removal ;
            sh:description "Specifies objects to be removed from a control in resolution." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:removes ] ;
    sh:targetClass oscal:Alteration .

oscal:AssessmentLog a sh:NodeShape ;
    rdfs:comment "A log of all assessment-related actions taken." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:AssessmentLogEntry ;
            sh:description "Identifies an individual risk response that occurred as part of managing an identified risk." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:entries ] ;
    sh:targetClass oscal:AssessmentLog .

oscal:AssessmentLogEntry a sh:NodeShape ;
    rdfs:comment "Identifies the result of an action and/or task that occurred as part of executing an assessment plan or assessment event." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:links ],
        [ sh:class oscal:RelatedTask ;
            sh:description "Identifies tasks for which the containing object is a consequence." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:related_tasks ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The end date/time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:end ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:class oscal:LoggedBy ;
            sh:description "Used to indicate who created a log entry in what role." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:logged_by ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The start date/time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:start ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:AssessmentLogEntry .

oscal:AssessmentPlan a sh:NodeShape ;
    rdfs:comment "An assessment plan, such as those provided by a FedRAMP assessor." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Metadata ;
            sh:description "Provides information about the containing document, and defines concepts shared across the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:metadata ],
        [ sh:class oscal:Task ;
            sh:description "A collection of tasks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:tasks ],
        [ sh:class oscal:ImportSSP ;
            sh:description "Used to import information about the system from an SSP." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:import_ssp ],
        [ sh:class oscal:AssessmentSubject ;
            sh:description "Identifies system elements being assessed." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:assessment_subjects ],
        [ sh:class oscal:LocalDefinitions ;
            sh:description "Used to define data objects that do not appear in the referenced SSP." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:local_definitions ],
        [ sh:datatype xsd:string ;
            sh:description "Assessment Plan Universally Unique Identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:BackMatter ;
            sh:description "A collection of resources that may be referenced from within the OSCAL document instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:back_matter ],
        [ sh:class oscal:TermsAndConditions ;
            sh:description "Terms and conditions under which an assessment can be performed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:terms_and_conditions ],
        [ sh:class oscal:ReviewedControls ;
            sh:description "Identifies the controls being assessed and their control objectives." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:reviewed_controls ],
        [ sh:class oscal:AssessmentAssets ;
            sh:description "Identifies the assets used to perform this assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:assessment_assets ] ;
    sh:targetClass oscal:AssessmentPlan .

oscal:AssessmentPlatform a sh:NodeShape ;
    rdfs:comment "Used to represent the toolset used to perform aspects of the assessment." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:UsesComponent ;
            sh:description "The set of components used by the assessment platform." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:uses_components ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:AssessmentPlatform .

oscal:AssessmentResults a sh:NodeShape ;
    rdfs:comment "Security assessment results, such as those provided by a FedRAMP assessor in a security assessment report." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:AssessmentResultsLocalDefinitions ;
            sh:description "Used to define data objects that do not appear in the referenced SSP." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:local_definitions ],
        [ sh:datatype xsd:string ;
            sh:description "Assessment Results Universally Unique Identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:ImportAssessmentPlan ;
            sh:description "Used to import information about the governing assessment plan." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:import_ap ],
        [ sh:class oscal:BackMatter ;
            sh:description "A collection of resources that may be referenced from within the OSCAL document instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:back_matter ],
        [ sh:class oscal:Result ;
            sh:description "A collection of assessment results." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:results ],
        [ sh:class oscal:Metadata ;
            sh:description "Provides information about the containing document, and defines concepts shared across the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:metadata ] ;
    sh:targetClass oscal:AssessmentResults .

oscal:AssessmentResultsLocalDefinitions a sh:NodeShape ;
    rdfs:comment "Used to define data objects that are referenced by the assessment results but do not appear in the imported assessment plan." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:LocalObjective ;
            sh:description "A collection of locally-defined control objectives." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:objectives_and_methods ],
        [ sh:class oscal:Activity ;
            sh:description "A collection of activities." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:activities ] ;
    sh:targetClass oscal:AssessmentResultsLocalDefinitions .

oscal:AssessmentSubjectSource a sh:NodeShape ;
    rdfs:comment "Assessment subjects will be identified while conducting the referenced activity." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A UUID reference to a task." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:task_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:AssessmentSubjectSource .

oscal:AssociatedActivity a sh:NodeShape ;
    rdfs:comment "Identifies an individual activity to be performed as part of a task." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A UUID reference to an activity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:activity_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:class oscal:ResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:responsible_roles ],
        [ sh:class oscal:AssessmentSubject ;
            sh:description "Assessment subjects or subject references for this object." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:subjects ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:AssociatedActivity .

oscal:AtFrequency a sh:NodeShape ;
    rdfs:comment "The task is intended to occur at the specified frequency." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:description "The unit of time for the period." ;
            sh:in ( "seconds" "minutes" "hours" "days" "months" "years" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path oscal:unit ],
        [ sh:datatype xsd:positiveInteger ;
            sh:description "The task must occur every period (in the given units)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:period ] ;
    sh:targetClass oscal:AtFrequency .

oscal:Attestation a sh:NodeShape ;
    rdfs:comment "A set of textual attestation statements, typically written by the assessor." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:AssessmentPart ;
            sh:description "A collection of parts." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:parts ],
        [ sh:class oscal:ResponsibleParty ;
            sh:description "Responsible party assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:responsible_parties ] ;
    sh:targetClass oscal:Attestation .

oscal:AuthorizationBoundary a sh:NodeShape ;
    rdfs:comment "A description of this system's authorization boundary, optionally supplemented with diagrams that illustrate the authorization boundary." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:props ],
        [ sh:class oscal:Diagram ;
            sh:description "A collection of diagrams that visually depict the subject." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:diagrams ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:description ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:AuthorizationBoundary .

oscal:AuthorizedPrivilege a sh:NodeShape ;
    rdfs:comment "Identifies a specific system privilege held by the user, along with an associated description and/or rationale for the privilege." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "Describes a function performed for a given authorized privilege." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:functions_performed ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:title ] ;
    sh:targetClass oscal:AuthorizedPrivilege .

oscal:Base64Resource a sh:NodeShape ;
    rdfs:comment "A resource encoded using the Base64 alphabet defined by RFC 2045." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A label that indicates the nature of a resource, as a data serialization or format." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:media_type ],
        [ sh:datatype xsd:base64Binary ;
            sh:description "The value associated with the containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:value ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the file before it was encoded as Base64 to be embedded in a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:filename ] ;
    sh:targetClass oscal:Base64Resource .

oscal:Capability a sh:NodeShape ;
    rdfs:comment "A grouping of other components and/or capabilities." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
