            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A glob expression matching the IDs of one or more controls to be selected." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:pattern ] ;
    sh:targetClass oscal:ControlMatching .

oscal:ControlObjectiveSelection a sh:NodeShape ;
    rdfs:comment "Identifies the control objectives of the assessment." ;
    sh:closed true ;
