            sh:order 0 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:SelectObjectiveById ;
            sh:description "Objectives to include in the assessment." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:include_objectives ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:props ],
        [ sh:class oscal:SelectObjectiveById ;
            sh:description "Objectives to exclude from the assessment." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:exclude_objectives ],
        [ sh:class oscal:IncludeAll ;
