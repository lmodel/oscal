            sh:order 6 ;
            sh:path oscal:date_authorized ],
        [ sh:class oscal:SspSystemCharacteristicsResponsibleParty ;
            sh:description "Responsible party assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path oscal:responsible_parties ],
        [ sh:class oscal:NetworkArchitecture ;
            sh:description "A description of the system's network architecture, optionally supplemented with diagrams that illustrate the network architecture." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path oscal:network_architecture ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:SystemInformation ;
            sh:description "Contains details about all information types that are stored, processed, or transmitted by the system." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:system_information ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "The full name of the system." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:system_name ],
        [ sh:class oscal:SecurityImpactLevel ;
            sh:description "The overall level of expected impact resulting from unauthorized disclosure, modification, or loss of access to information." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:security_impact_level ],
        [ sh:class oscal:SystemStatus ;
            sh:description "Describes the operational status of the system." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:system_status ],
        [ sh:class oscal:SystemId ;
            sh:description "Unique identifiers for the system." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:system_ids ],
        [ sh:datatype xsd:string ;
            sh:description "A short name for the system, such as an acronym, that is suitable for display in a data table or summary list." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:system_name_short ],
        [ sh:class oscal:SspSystemCharacteristicsProp ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:class oscal:DataFlow ;
            sh:description "A description of the logical flow of information within the system and across its boundaries, optionally supplemented with diagrams." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path oscal:data_flow ],
        [ sh:datatype xsd:string ;
            sh:description "The overall information system sensitivity categorization, such as defined by FIPS-199." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:security_sensitivity_level ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:class oscal:AuthorizationBoundary ;
            sh:description "A description of this system's authorization boundary, optionally supplemented with diagrams that illustrate the authorization boundary." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:authorization_boundary ] ;
    sh:targetClass oscal:SystemCharacteristics .

oscal:SystemImplementation a sh:NodeShape ;
    rdfs:comment "Provides information as to how the system is implemented." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SspInventoryItem ;
            sh:description "A collection of inventory items." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:inventory_items ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:links ],
        [ sh:class oscal:SspSystemComponent ;
            sh:description "A collection of system components." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:components ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:props ],
        [ sh:class oscal:SystemUser ;
            sh:description "A collection of system users." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:users ],
        [ sh:class oscal:LeveragedAuthorization ;
            sh:description "A description of another authorized system from which this system inherits capabilities that satisfy security requirements." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:leveraged_authorizations ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:SystemImplementation .

oscal:SystemInformation a sh:NodeShape ;
    rdfs:comment "Contains details about all information types that are stored, processed, or transmitted by the system, such as privacy information." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SspSystemInformationProp ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:props ],
        [ sh:class oscal:SspSystemInformationLink ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:links ],
        [ sh:class oscal:InformationType ;
            sh:description "Contains details about one information type that is stored, processed, or transmitted by the system." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:information_types ] ;
    sh:targetClass oscal:SystemInformation .

oscal:SystemSecurityPlan a sh:NodeShape ;
    rdfs:comment "A system security plan, such as those described in NIST SP 800-18." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SspControlImplementation ;
            sh:description "Describes how the system satisfies a set of controls." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:control_implementation ],
        [ sh:class oscal:SystemCharacteristics ;
            sh:description "Contains the characteristics of the system, such as its name, purpose, and security impact level." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:system_characteristics ],
        [ sh:class oscal:ImportProfile ;
            sh:description "Used to import the OSCAL profile representing the system's control baseline." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:import_profile ],
        [ sh:class oscal:BackMatter ;
            sh:description "A collection of resources that may be referenced from within the OSCAL document instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:back_matter ],
        [ sh:class oscal:Metadata ;
            sh:description "Provides information about the containing document, and defines concepts shared across the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:metadata ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:SystemImplementation ;
            sh:description "Provides information as to how the system is implemented." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:system_implementation ] ;
    sh:targetClass oscal:SystemSecurityPlan .

oscal:SystemStatus a sh:NodeShape ;
    rdfs:comment "Describes the operational status of the system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The current operating status of the system." ;
            sh:in ( "operational" "under-development" "under-major-modification" "disposition" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path oscal:state ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:SystemStatus .

oscal:TaskDependency a sh:NodeShape ;
    rdfs:comment "Used to indicate that a task is dependent on another task." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A UUID reference to a task." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:task_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:TaskDependency .

oscal:TermsAndConditions a sh:NodeShape ;
    rdfs:comment "Used to define various terms and conditions under which an assessment can be performed." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:TermsAndConditionsPart ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:parts ] ;
    sh:targetClass oscal:TermsAndConditions .

oscal:ThreatId a sh:NodeShape ;
    rdfs:comment "A pointer, by ID, to an externally-defined threat." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Specifies the system or scheme from which the identifier originates." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oscal:system ],
        [ sh:description "A unique human-oriented identifier within a particular context." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:id ],
        [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ] ;
    sh:targetClass oscal:ThreatId .

oscal:UsesComponent a sh:NodeShape ;
    rdfs:comment "The set of components that are used by the assessment platform." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A UUID reference to a component." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:component_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:ResponsibleParty ;
            sh:description "Responsible party assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:responsible_parties ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:UsesComponent .

oscal:WithinDateRange a sh:NodeShape ;
    rdfs:comment "The task is intended to occur within the specified date range." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "The start date/time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:start ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The end date/time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:end ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:WithinDateRange .

oscal:Activity a sh:NodeShape ;
    rdfs:comment "Identifies an assessment or related process that can be performed. In the assessment plan, this is an intended activity." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:props ],
        [ sh:class oscal:ResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:responsible_roles ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:class oscal:ReviewedControls ;
            sh:description "A reference to reviewed controls for this activity or step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:related_controls ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:class oscal:Step ;
            sh:description "A collection of steps in an activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:steps ] ;
    sh:targetClass oscal:Activity .

oscal:Address a sh:NodeShape ;
    rdfs:comment "A postal address for the location." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Postal or ZIP code for mailing address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:postal_code ],
        [ sh:datatype xsd:string ;
            sh:description "The ISO 3166-1 alpha-2 country code for the mailing address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:country ],
        [ sh:datatype xsd:string ;
            sh:description "A single line of an address." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:addr_lines ],
        [ sh:datatype xsd:string ;
            sh:description "State, province or analogous geographical region for a mailing address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:state ],
        [ sh:datatype xsd:string ;
            sh:description "City, town or geographical region for the mailing address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:city ],
        [ sh:description "Indicates the type of address. Recommended values: home, work. Other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "home" "work" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:type ] ;
    sh:targetClass oscal:Address .

oscal:AssessmentSelectControlById a sh:NodeShape ;
    rdfs:comment "Select a specific control for inclusion/exclusion in the assessment by literal control ID and optional statement IDs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A reference to a control by its identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:control_id ],
        [ sh:datatype xsd:string ;
            sh:description "Statement IDs for control selection." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:statement_ids ] ;
    sh:targetClass oscal:AssessmentSelectControlById .

oscal:AssociatedRisk a sh:NodeShape ;
    rdfs:comment "Relates the finding to a set of referenced risks." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A machine-oriented identifier reference to a risk defined in the list of risks." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:risk_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:AssociatedRisk .

oscal:ByComponent a sh:NodeShape ;
    rdfs:comment "Defines how the referenced component implements a set of controls." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:class oscal:SspByComponentResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:responsible_roles ],
        [ sh:class oscal:SspControlOriginationProp ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:class oscal:ImplementationStatus ;
            sh:description "Identifies the implementation status of the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:implementation_status ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:InheritedControlImplementation ;
            sh:description "Describes a control implementation inherited by a leveraging system." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:inherited ],
        [ sh:class oscal:SetParameter ;
            sh:description "Identifies the parameter that will be set by the enclosed value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:set_parameters ],
        [ sh:datatype xsd:string ;
            sh:description "A UUID reference to a component." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:component_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Export ;
            sh:description "Defines a set of control implementations that are provided as reference implementations for use by organizations implementing the leveraged system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:export ],
        [ sh:class oscal:SspByComponentLink ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:class oscal:SatisfiedControlImplementation ;
            sh:description "Describes how this system satisfies a responsibility imposed by a leveraged system." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:satisfied ] ;
    sh:targetClass oscal:ByComponent .

oscal:ComponentStatus a sh:NodeShape ;
    rdfs:comment "Describes the operational status of the system component." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The operational status." ;
            sh:in ( "under-development" "operational" "disposition" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:state ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ComponentStatus .

oscal:ControlImplementationSet a sh:NodeShape ;
    rdfs:comment "Defines how the component or capability supports a set of controls." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:description "Reference to an external catalog or profile resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oscal:source ],
        [ sh:class oscal:ImplementedRequirement ;
            sh:description "Control implementation requirement entries in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:implemented_requirements ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:props ],
        [ sh:class oscal:SetParameter ;
            sh:description "Parameter values applied in the containing implementation context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:set_parameters ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:ControlImplementationSet .

oscal:ControlPart a sh:NodeShape ;
    rdfs:comment "An annotated, markup-based textual element of a control's or catalog group's definition, or a child of another part." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A unique human-oriented identifier within a particular context." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:id ],
        [ sh:class oscal:ControlPart ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:parts ],
        [ sh:description "An optional namespace qualifying a name. Allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:_class ],
        [ sh:datatype xsd:string ;
            sh:description "Permits multiple paragraphs, lists, tables etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:prose ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that uniquely identifies an attribute or semantic type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:name ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:ControlPart .

oscal:DocumentId a sh:NodeShape ;
    rdfs:comment "A document identifier qualified by an identifier scheme." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A document identifier value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:identifier ],
        [ sh:description "Qualifies the kind of identifier using a URI." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "http://www.doi.org/" ) ] [ sh:nodeKind sh:IRI ] ) ;
            sh:order 0 ;
            sh:path oscal:scheme ] ;
    sh:targetClass oscal:DocumentId .

oscal:Finding a sh:NodeShape ;
    rdfs:comment "Describes an individual finding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:RelatedObservation ;
            sh:description "Relates the containing object to a set of referenced observations." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:related_observations ],
        [ sh:datatype xsd:string ;
            sh:description "A reference to the implementation statement in the SSP to which this finding is related." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:implementation_statement_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:FindingTarget ;
            sh:description "Identifies the target of a finding." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:target ],
        [ sh:class oscal:AssociatedRisk ;
            sh:description "Relates the finding to a set of referenced risks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:related_risks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:props ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:class oscal:Origin ;
            sh:description "Identifies the source of observations, findings, or risks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:origins ] ;
    sh:targetClass oscal:Finding .

oscal:GapSummary a sh:NodeShape ;
    rdfs:comment "A summary of controls that were not mapped." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SelectControlById ;
            sh:description "Controls that remain unmapped." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:unmapped_controls ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:GapSummary .

oscal:Group a sh:NodeShape ;
    rdfs:comment "A group of controls, or of groups of controls." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Control ;
            sh:description "A collection of controls." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:controls ],
        [ sh:class oscal:Parameter ;
            sh:description "Parameters providing a mechanism for the dynamic assignment of value(s) in a control." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:params ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:_class ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the group, which may be used by a tool for display and navigation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:title ],
        [ sh:class oscal:Part ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:parts ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the group for the purpose of cross-linking within the defining instance or from other instances that reference the catalog." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:id ],
        [ sh:class oscal:Group ;
            sh:description "A collection of control groups." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:groups ] ;
    sh:targetClass oscal:Group .

oscal:ImplementationResponsibleRole a sh:NodeShape ;
    rdfs:comment "Implementation-common scoped responsible role." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "References to party UUIDs." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:party_uuids ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:description "A human-oriented identifier reference to a role performed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "asset-owner" "asset-administrator" "security-operations" "network-operations" "incident-response" "help-desk" "configuration-management" "maintainer" "provider" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:role_id ] ;
    sh:targetClass oscal:ImplementationResponsibleRole .

oscal:ImplementationStatus a sh:NodeShape ;
    rdfs:comment "Indicates the degree to which a given control is implemented." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ],
        [ sh:description "Identifies the implementation status of the control or control objective. Recommended values are in ImplementationStatusStateEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "implemented" "partial" "planned" "alternative" "not-applicable" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:state ] ;
    sh:targetClass oscal:ImplementationStatus .

oscal:ImplementedComponent a sh:NodeShape ;
    rdfs:comment "The set of components that are implemented in a given system inventory item." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ImplementationCommonLink ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:class oscal:ImplementationCommonProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:class oscal:ImplementationResponsibleParty ;
            sh:description "Responsible party assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:responsible_parties ],
        [ sh:datatype xsd:string ;
            sh:description "A UUID reference to a component." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:component_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ImplementedComponent .

oscal:ImportSSP a sh:NodeShape ;
    rdfs:comment "Used by the assessment plan and POA&M to import information about the system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ImportSSP .

oscal:InsertControls a sh:NodeShape ;
    rdfs:comment "Specifies which controls to use in the containing context (as part of a group or custom merge structure)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A designation of how a selection of controls is to be ordered." ;
            sh:in ( "keep" "ascending" "descending" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path oscal:order ],
        [ sh:class oscal:SelectControlById ;
            sh:description "Control-selection entries to exclude in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:exclude_controls ],
        [ sh:class oscal:SelectControlById ;
            sh:description "Control-selection entries to include in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:include_controls ],
        [ sh:class oscal:IncludeAll ;
            sh:description "Include all selectable objects in the containing OSCAL selection context." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:include_all ] ;
    sh:targetClass oscal:InsertControls .

oscal:LocalObjective a sh:NodeShape ;
    rdfs:comment "A local definition of a control objective for this assessment. Uses catalog syntax for control objective and assessment actions." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A reference to a control by its identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:control_id ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:ControlPart ;
            sh:description "A collection of parts." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:parts ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:LocalObjective .

oscal:LoggedBy a sh:NodeShape ;
    rdfs:comment "Used to indicate who created a log entry in what role." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented identifier reference to the party who is making the log entry." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:party_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A reference to a role by its identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:role_id ] ;
    sh:targetClass oscal:LoggedBy .

oscal:MappingItem a sh:NodeShape ;
    rdfs:comment "A source or target item participating in a mapping entry." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifier reference of a source/target subject." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:id_ref ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:description "Indicates the nature or kind of the containing object." ;
            sh:in ( "control" "statement" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:type ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:MappingItem .

oscal:MappingResourceReference a sh:NodeShape ;
    rdfs:comment "A reference to the source or target resource for a mapping." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:remarks ],
        [ sh:description "The semantic type of the referenced resource. OSCAL defines catalog and profile, while locally defined values are also permitted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "catalog" "profile" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:type ],
        [ sh:description "An optional namespace qualifying a name. Allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:ns ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:href ] ;
    sh:targetClass oscal:MappingResourceReference .

oscal:Observation a sh:NodeShape ;
    rdfs:comment "Describes an individual observation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:RelevantEvidence ;
            sh:description "Links the observation to relevant evidence." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:relevant_evidence ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date/time identifying when the finding information is no longer considered valid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path oscal:expires ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:class oscal:SubjectReference ;
            sh:description "Assessment subjects or subject references for this object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:subjects ],
        [ sh:class oscal:Origin ;
            sh:description "Identifies the source of observations, findings, or risks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:origins ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date/time stamp identifying when the finding information was collected." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path oscal:collected ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:description "Identifies the nature of the observation. Recommended values are in ObservationTypeEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:or ( [ sh:in ( "ssp-statement-issue" "control-objective" "mitigation" "finding" "discovery" "historic" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 4 ;
            sh:path oscal:types ],
        [ sh:description "Identifies how the observation was made. Recommended values are in ObservationMethodEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "EXAMINE" "INTERVIEW" "TEST" "UNKNOWN" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path oscal:methods ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ] ;
    sh:targetClass oscal:Observation .

oscal:ParameterConstraint a sh:NodeShape ;
    rdfs:comment "A formal or informal expression of a constraint or test." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ConstraintTest ;
            sh:description "A test expression which is expected to be evaluated by a tool." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:tests ],
        [ sh:datatype xsd:string ;
            sh:description "A textual summary of the constraint to be applied." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:description ] ;
    sh:targetClass oscal:ParameterConstraint .

oscal:ParameterGuideline a sh:NodeShape ;
    rdfs:comment "A prose statement that provides a recommendation for the use of a parameter." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Prose permits multiple paragraphs, lists, tables etc." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:prose ] ;
    sh:targetClass oscal:ParameterGuideline .

oscal:ParameterSelection a sh:NodeShape ;
    rdfs:comment "Presenting a choice among alternatives." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Describes the number of selections that must occur. Without this setting, only one value should be assumed to be permitted." ;
            sh:in ( "one" "one-or-more" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path oscal:how_many ],
        [ sh:datatype xsd:string ;
            sh:description "A value selection among several such options." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:choice ] ;
    sh:targetClass oscal:ParameterSelection .

oscal:ProfileGroup a sh:NodeShape ;
    rdfs:comment "A group of (selected) controls or of groups of controls within a profile custom merge structure." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ProfileGroup ;
            sh:description "A collection of control groups." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:groups ],
        [ sh:class oscal:Parameter ;
            sh:description "Parameters providing a mechanism for the dynamic assignment of value(s) in a control." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:params ],
        [ sh:class oscal:InsertControls ;
            sh:description "Specifies which controls to use in the containing context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:insert_controls ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:_class ],
        [ sh:datatype xsd:string ;
            sh:description "A unique human-oriented identifier within a particular context." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:id ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:title ],
        [ sh:class oscal:Part ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:parts ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:ProfileGroup .

oscal:Risk a sh:NodeShape ;
    rdfs:comment "An identified risk." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:RiskLog ;
            sh:description "A log of all risk-related tasks taken." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:risk_log ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path oscal:links ],
        [ sh:class oscal:RelatedObservation ;
            sh:description "Relates the containing object to a set of referenced observations." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:related_observations ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path oscal:props ],
        [ sh:class oscal:Origin ;
            sh:description "Identifies the source of observations, findings, or risks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:origins ],
        [ sh:description "Status indicator used by the containing OSCAL context. Allowed values are constrained by class-level slot_usage." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "open" "investigating" "remediating" "deviation-requested" "deviation-approved" "closed" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 12 ;
            sh:path oscal:status ],
        [ sh:datatype xsd:string ;
            sh:description "An assessor's summary of the risk, in narrative form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:statement ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date/time by which the risk must be resolved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path oscal:deadline ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:class oscal:MitigatingFactor ;
            sh:description "Describes existing mitigating factors that may affect the overall determination of the risk." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:mitigating_factors ],
        [ sh:class oscal:Response ;
            sh:description "Describes either recommended or actual responses to a risk." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:remediations ],
        [ sh:class oscal:ThreatId ;
            sh:description "The referenced threat identifiers." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:threat_ids ],
        [ sh:class oscal:Characterization ;
            sh:description "Supporting information about the risk and how it relates to the system." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:characterizations ] ;
    sh:targetClass oscal:Risk .

oscal:SelectObjectiveById a sh:NodeShape ;
    rdfs:comment "Used to select a control objective for inclusion/exclusion." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Reference to a control objective by its identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:objective_id ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:SelectObjectiveById .

oscal:SelectSubjectById a sh:NodeShape ;
    rdfs:comment "Identifies a set of assessment subjects to include/exclude by UUID." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Indicates the nature or kind of the containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "component" "inventory-item" "location" "party" "user" "resource" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:type ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A UUID reference to the identified subject." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:subject_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:SelectSubjectById .

oscal:SspAllowsAuthenticatedScanProp a sh:NodeShape ;
    rdfs:comment "SSP-scoped property used for component and inventory allows-authenticated-scan." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:in ( "yes" "no" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ] ;
    sh:targetClass oscal:SspAllowsAuthenticatedScanProp .

oscal:SspImplementedRequirementResponsibleRole a sh:NodeShape ;
    rdfs:comment "SSP-scoped responsible role used by implemented requirement and statement contexts." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "References to party UUIDs." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:party_uuids ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:description "A human-oriented identifier reference to a role performed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "asset-owner" "asset-administrator" "security-operations" "network-operations" "incident-response" "help-desk" "configuration-management" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:role_id ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:SspImplementedRequirementResponsibleRole .

oscal:SystemId a sh:NodeShape ;
    rdfs:comment "A human-oriented, globally unique identifier for a system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A human-readable label for a specific identifier scheme. Recommended values are in SystemIdentifierTypeEnum; other URI values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "http://fedramp.gov" "http://fedramp.gov/ns/oscal" "https://ietf.org/rfc/rfc4122" "http://ietf.org/rfc/rfc4122" "http://datatracker.ietf.org/doc/html/rfc4122" ) ] [ sh:nodeKind sh:IRI ] ) ;
            sh:order 1 ;
            sh:path oscal:identifier_type ],
        [ sh:datatype xsd:string ;
            sh:description "A unique human-oriented identifier within a particular context." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:id ] ;
    sh:targetClass oscal:SystemId .

oscal:TelephoneNumber a sh:NodeShape ;
    rdfs:comment "A telephone service number as defined by ITU-T E.164." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Indicates the type of phone number. Recommended values: home, office, mobile. Other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "home" "office" "mobile" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:type ],
        [ sh:datatype xsd:string ;
            sh:description "A telephone number value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:number ] ;
    sh:targetClass oscal:TelephoneNumber .

oscal:TermsAndConditionsPart a sh:NodeShape ;
    rdfs:comment "A terms-and-conditions scoped assessment part." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:TermsAndConditionsPart ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:parts ],
        [ sh:description "An optional namespace qualifying a name. Allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Permits multiple paragraphs, lists, tables etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:prose ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:props ],
        [ sh:description "A textual label that uniquely identifies an attribute or semantic type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "asset" "method" "objective" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:_class ] ;
    sh:targetClass oscal:TermsAndConditionsPart .

oscal:AssessmentAssets a sh:NodeShape ;
    rdfs:comment "Identifies the assets used to perform this assessment." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:AssessmentPlatform ;
            sh:description "A collection of assessment platforms." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:assessment_platforms ],
        [ sh:class oscal:SystemComponent ;
            sh:description "A collection of system components." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:components ] ;
    sh:targetClass oscal:AssessmentAssets .

oscal:AssessmentPart a sh:NodeShape ;
    rdfs:comment "A partition of an assessment plan or results or a child of another part." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Permits multiple paragraphs, lists, tables etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:prose ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:_class ],
        [ sh:class oscal:AssessmentPart ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:parts ],
        [ sh:description "An optional namespace qualifying a name. Allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:props ],
        [ sh:description "A textual label that uniquely identifies an attribute or semantic type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "asset" "method" "objective" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:title ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:AssessmentPart .

oscal:ConfidenceScore a sh:NodeShape ;
    rdfs:comment "Confidence represented as a category and/or percentage value." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Confidence category label or qualifier category value." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "unspecified" "high" "medium" "low" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:category ],
        [ sh:datatype xsd:float ;
            sh:description "A decimal percentage value in the range 0 to 1." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:percentage ] ;
    sh:targetClass oscal:ConfidenceScore .

oscal:Control a sh:NodeShape ;
    rdfs:comment "A structured object representing a requirement or guideline, which when implemented will reduce an aspect of risk related to an information system and its information." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A name given to the control, which may be used by a tool for display and navigation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:title ],
        [ sh:class oscal:Part ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:parts ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies a control such that it can be referenced in the defining catalog and other OSCAL instances (e.g., profiles)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:id ],
        [ sh:class oscal:Control ;
            sh:description "A collection of controls." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:controls ],
        [ sh:class oscal:Parameter ;
            sh:description "Parameters providing a mechanism for the dynamic assignment of value(s) in a control." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:params ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:_class ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:Control .

oscal:Coverage a sh:NodeShape ;
    rdfs:comment "A percentage representing target coverage by source mappings." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Percentage coverage of targets by sources." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:target_coverage ],
        [ sh:description "Method used to determine the coverage value. Recommended values are in CoverageGenerationMethodEnum; other values are permitted." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "arbitrary" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:generation_method ] ;
    sh:targetClass oscal:Coverage .

oscal:Diagram a sh:NodeShape ;
    rdfs:comment "A graphic that provides a visual representation the system, or some aspect of it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SspDiagramLink ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A brief caption to annotate the diagram." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:caption ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:Diagram .

oscal:ImpactLevel a sh:NodeShape ;
    rdfs:comment "The expected level of impact resulting from the described information's confidentiality, integrity, or availability affect." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The prescribed base (Confidentiality, Integrity, or Availability) security impact level." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "fips-199-low" "fips-199-moderate" "fips-199-high" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 2 ;
            sh:path oscal:base ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:props ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:links ],
        [ sh:description "The selected (Confidentiality, Integrity, or Availability) security impact level." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "fips-199-low" "fips-199-moderate" "fips-199-high" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path oscal:selected ],
        [ sh:datatype xsd:string ;
            sh:description "If the selected security level is different from the base security level, this contains the justification for the change." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:adjustment_justification ] ;
    sh:targetClass oscal:ImpactLevel .

oscal:ImplementationResponsibleParty a sh:NodeShape ;
