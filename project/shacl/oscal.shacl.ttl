oscal:SystemCharacteristics a sh:NodeShape ;
    rdfs:comment "Contains the characteristics of the system, such as its name, purpose, and security impact level." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The date the system received its authorization." ;
            sh:maxCount 1 ;
