oscal:ControlSelection a sh:NodeShape ;
    rdfs:comment "Identifies the controls being assessed." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:IncludeAll ;
            sh:description "Include all selectable objects in the containing OSCAL selection context." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:include_all ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:description ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:props ],
        [ sh:class oscal:AssessmentSelectControlById ;
            sh:description "Control-selection entries to exclude in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:exclude_controls ],
        [ sh:class oscal:AssessmentSelectControlById ;
            sh:description "Control-selection entries to include in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:include_controls ] ;
    sh:targetClass oscal:ControlSelection .

oscal:DataFlow a sh:NodeShape ;
    rdfs:comment "A description of the logical flow of information within the system and across its boundaries, optionally supplemented with diagrams." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Diagram ;
            sh:description "A collection of diagrams that visually depict the subject." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:diagrams ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:description ] ;
    sh:targetClass oscal:DataFlow .

oscal:DefinedComponent a sh:NodeShape ;
    rdfs:comment "A defined component that can be part of an implemented system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Protocol ;
            sh:description "Information about the protocol used to provide a service." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:protocols ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A summary of the technological or business purpose of the component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:purpose ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the nature or kind of the containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:type ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:description ],
        [ sh:class oscal:ResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:responsible_roles ],
        [ sh:class oscal:ControlImplementationSet ;
            sh:description "Control implementation sets for a component or capability." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:control_implementations ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:DefinedComponent .

oscal:EventTiming a sh:NodeShape ;
    rdfs:comment "The timing under which the task is intended to occur." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:WithinDateRange ;
            sh:description "The task is intended to occur within the specified date range." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:within_date_range ],
        [ sh:class oscal:AtFrequency ;
            sh:description "The task is intended to occur at the specified frequency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:at_frequency ],
        [ sh:class oscal:OnDateCondition ;
            sh:description "The task is intended to occur on the specified date." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:on_date ] ;
    sh:targetClass oscal:EventTiming .

oscal:Export a sh:NodeShape ;
    rdfs:comment "Defines a set of control implementations that are provided as reference implementations for use by organizations implementing the leveraged system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ControlResponsibility ;
            sh:description "Describes a control implementation responsibility imposed on a leveraging system." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:responsibilities ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:description ],
        [ sh:class oscal:ProvidedControlImplementation ;
            sh:description "Describes a capability which may be inherited by a leveraging system." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:provided ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:Export .

oscal:Facet a sh:NodeShape ;
    rdfs:comment "An individual characteristic that is part of a larger set produced by the same actor." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:remarks ],
        [ sh:description "Specifies the system or scheme from which the identifier originates." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:system ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that uniquely identifies an attribute or semantic type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "The value associated with the containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:value ] ;
    sh:targetClass oscal:Facet .

oscal:FindingTarget a sh:NodeShape ;
    rdfs:comment "Captures an assessor's conclusions regarding the degree to which an objective is satisfied." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:title ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:links ],
        [ sh:description "Indicates the nature or kind of the containing object." ;
            sh:in ( "statement-id" "objective-id" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:type ],
        [ sh:class oscal:ObjectiveStatus ;
            sh:description "Status indicator used by the containing OSCAL context. Allowed values are constrained by class-level slot_usage." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:status ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the specific target qualified by the type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:target_id ],
        [ sh:class oscal:ImplementationStatus ;
            sh:description "Identifies the implementation status of the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:implementation_status ] ;
    sh:targetClass oscal:FindingTarget .

oscal:Hash a sh:NodeShape ;
    rdfs:comment "A representation of a cryptographic digest generated over a resource using a specified hash algorithm." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The value associated with the containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:value ],
        [ sh:description "The digest method by which a hash is derived. Recommended values are in HashAlgorithmEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "SHA-224" "SHA-256" "SHA-384" "SHA-512" "SHA3-224" "SHA3-256" "SHA3-384" "SHA3-512" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:algorithm ] ;
    sh:targetClass oscal:Hash .

oscal:IdentifiedSubject a sh:NodeShape ;
    rdfs:comment "Used to detail assessment subjects that were identified by this task." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
