oscal:SystemComponent a sh:NodeShape ;
    rdfs:comment "A defined component that can be part of an implemented system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ImplementationCommonProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "A summary of the technological or business purpose of the component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:purpose ],
        [ sh:class oscal:ImplementationCommonLink ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:links ],
        [ sh:description "Indicates the nature or kind of the containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "this-system" "system" "interconnection" "software" "hardware" "service" "policy" "physical" "process-procedure" "plan" "guidance" "standard" "validation" "network" "region" "zone" "resource-container" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:type ],
        [ sh:class oscal:Protocol ;
            sh:description "Information about the protocol used to provide a service." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:protocols ],
        [ sh:class oscal:ImplementationResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:responsible_roles ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:title ],
        [ sh:class oscal:ComponentStatus ;
            sh:description "Status indicator used by the containing OSCAL context. Allowed values are constrained by class-level slot_usage." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:status ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:SystemComponent .

oscal:Task a sh:NodeShape ;
    rdfs:comment "Represents a scheduled event or milestone, which may be associated with a series of assessment actions." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:description ],
        [ sh:class oscal:AssessmentSubject ;
            sh:description "Assessment subjects or subject references for this object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:subjects ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:EventTiming ;
            sh:description "The timing under which a task is intended to occur." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:timing ],
        [ sh:description "Indicates the nature or kind of the containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "milestone" "action" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:type ],
        [ sh:class oscal:ResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:responsible_roles ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:title ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:props ],
        [ sh:class oscal:TaskDependency ;
            sh:description "Tasks that this task depends on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:dependencies ],
        [ sh:class oscal:AssociatedActivity ;
            sh:description "Activities associated with this task." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:associated_activities ],
        [ sh:class oscal:Task ;
            sh:description "A collection of tasks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:tasks ] ;
    sh:targetClass oscal:Task .

oscal:AssessmentSubject a sh:NodeShape ;
    rdfs:comment "Identifies system elements being assessed, such as components, inventory items, and locations." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:class oscal:IncludeAll ;
            sh:description "Include all selectable objects in the containing OSCAL selection context." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:include_all ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:SelectSubjectById ;
            sh:description "Assessment subjects to include." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:include_subjects ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:props ],
        [ sh:description "Indicates the nature or kind of the containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "component" "inventory-item" "location" "party" "user" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:type ],
        [ sh:class oscal:SelectSubjectById ;
            sh:description "Assessment subjects to exclude." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:exclude_subjects ] ;
    sh:targetClass oscal:AssessmentSubject .

oscal:IncludeAll a sh:NodeShape ;
    rdfs:comment "Include all controls from the imported catalog or profile resources." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass oscal:IncludeAll .

oscal:Parameter a sh:NodeShape ;
    rdfs:comment "Parameters provide a mechanism for the dynamic assignment of value(s) in a control." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:links ],
        [ sh:class oscal:ParameterProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A short, placeholder name for the parameter, which can be used as a substitute for a value if no value is assigned." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:label ],
        [ sh:class oscal:ParameterGuideline ;
            sh:description "A prose statement that provides a recommendation for the use of a parameter." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:guidelines ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a characterization of the type, purpose, use or scope of the parameter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:_class ],
        [ sh:class oscal:ParameterSelection ;
            sh:description "Presenting a choice among alternatives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:select ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "(deprecated) Another parameter invoking this one. This construct has been deprecated and should not be used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:depends_on ],
        [ sh:class oscal:ParameterConstraint ;
            sh:description "A formal or informal expression of a constraint or test." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:constraints ],
        [ sh:datatype xsd:string ;
            sh:description "Describes the purpose and use of a parameter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:usage ],
        [ sh:datatype xsd:string ;
            sh:description "A parameter value or set of values." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:values ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the parameter." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:id ] ;
    sh:targetClass oscal:Parameter .

oscal:Part a sh:NodeShape ;
    rdfs:comment "An annotated, markup-based textual element of a control's or catalog group's definition, or a child of another part." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:PartProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the part." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:id ],
        [ sh:description "An optional namespace qualifying the part's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:class oscal:Part ;
            sh:description "A collection of parts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:parts ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that uniquely identifies the part's semantic type, which exists in a value space qualified by the ns." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "An optional textual providing a sub-type or characterization of the part's name, or a category to which the part belongs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:_class ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "An optional name given to the part, which may be used by a tool for display and navigation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "Permits multiple paragraphs, lists, tables etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:prose ] ;
    sh:targetClass oscal:Part .

oscal:SelectControlById a sh:NodeShape ;
    rdfs:comment "Select a control or controls from an imported control set." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Selecting a control by its ID given as a literal." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:with_ids ],
        [ sh:class oscal:ControlMatching ;
            sh:description "Selecting a set of controls by matching their IDs with a wildcard pattern." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:matching ],
        [ sh:description "When a control is included, whether its child (dependent) controls are also included." ;
            sh:in ( "yes" "no" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path oscal:with_child_controls ] ;
    sh:targetClass oscal:SelectControlById .

oscal:SetParameter a sh:NodeShape ;
    rdfs:comment "Identifies the parameter that will be set by the enclosed value." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A parameter value or set of values." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:values ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier for the parameter being set or referenced." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:param_id ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:SetParameter .

oscal:SspByComponentResponsibleRole a sh:NodeShape ;
    rdfs:comment "SSP-scoped responsible role used by by-component contexts." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A human-oriented identifier reference to a role performed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "asset-owner" "asset-administrator" "security-operations" "network-operations" "incident-response" "help-desk" "configuration-management" "maintainer" "provider" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:role_id ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "References to party UUIDs." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:party_uuids ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:SspByComponentResponsibleRole .

oscal:ImplementationCommonLink a sh:NodeShape ;
    rdfs:comment "Implementation-common scoped OSCAL link." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A textual label to associate with the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:text ],
        [ sh:datatype xsd:string ;
            sh:description "In case where the href points to a back-matter/resource, this value will indicate the URI fragment to append to any rlink associated with the resource. This value MUST be URI encoded." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:resource_fragment ],
        [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ],
        [ sh:datatype xsd:string ;
            sh:description "A label that indicates the nature of a resource, as a data serialization or format." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:media_type ],
        [ sh:description "Describes the type of relationship provided by the link's hypertext reference. This can be an indicator of the link's purpose." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "depends-on" "validation" "proof-of-compliance" "baseline-template" "uses-service" "system-security-plan" "uses-network" "imported-from" "validation-details" "provided-by" "used-by" "isa-agreement" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:rel ] ;
    sh:targetClass oscal:ImplementationCommonLink .

oscal:Origin a sh:NodeShape ;
    rdfs:comment "Identifies the source of the finding, such as a tool, interviewed person, or activity." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:OriginActor ;
            sh:description "The actor that produces an observation, a finding, or a risk." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:actors ],
        [ sh:class oscal:RelatedTask ;
            sh:description "Identifies tasks for which the containing object is a consequence." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:related_tasks ] ;
    sh:targetClass oscal:Origin .

oscal:ResponsibleParty a sh:NodeShape ;
    rdfs:comment "A reference to a set of persons and/or organizations that have responsibility for performing the referenced role in the context of the containing object." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:description "A reference to a role performed by a party." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "creator" "prepared-by" "prepared-for" "content-approver" "contact" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path oscal:role_id ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "References to party UUIDs." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:party_uuids ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:ResponsibleParty .

oscal:BackMatter a sh:NodeShape ;
    rdfs:comment "A collection of resources that may be referenced from within the OSCAL document instance." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Resource ;
            sh:description "A resource associated with content in the containing document instance. A resource may be directly included in the document using base64 encoding or may point to one or more equivalent internet resources." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:resources ] ;
    sh:targetClass oscal:BackMatter .

oscal:Metadata a sh:NodeShape ;
    rdfs:comment "Provides information about the containing document, and defines concepts shared across the document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path oscal:links ],
        [ sh:class oscal:Location ;
            sh:description "A physical point of presence, which may be associated with people, organizations, or other concepts within the current or linked OSCAL document." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:locations ],
        [ sh:class oscal:MetadataProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path oscal:props ],
        [ sh:class oscal:Party ;
            sh:description "An organization or person, which may be associated with roles or other concepts within the current or linked OSCAL document." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:parties ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time the document was last made available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:published ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time the document was last stored for later retrieval." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:last_modified ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:class oscal:ResponsibleParty ;
            sh:description "Responsible party assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path oscal:responsible_parties ],
        [ sh:datatype xsd:string ;
            sh:description "The OSCAL model version the document was authored against." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:oscal_version ],
        [ sh:class oscal:DocumentId ;
            sh:description "Document identifiers qualified by an identifier scheme." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:document_ids ],
        [ sh:class oscal:Revision ;
            sh:description "An entry in a sequential list of revisions to the containing document, expected to be in reverse chronological order (i.e. latest first)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:revisions ],
        [ sh:class oscal:Role ;
            sh:description "Defines a function, which might be assigned to a party in a specific situation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:roles ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:title ],
        [ sh:class oscal:Action ;
            sh:description "An action applied by a role within a given party to the content." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:actions ],
        [ sh:datatype xsd:string ;
            sh:description "Used to distinguish a specific revision of an OSCAL document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:version ] ;
    sh:targetClass oscal:Metadata .

oscal:ResponsibleRole a sh:NodeShape ;
    rdfs:comment "A reference to a role with responsibility for performing a function relative to the containing object, optionally associated with a set of persons and/or organizations that perform that role." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-oriented identifier reference to a role performed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:role_id ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "References to party UUIDs." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:party_uuids ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:ResponsibleRole .

oscal:Property a sh:NodeShape ;
    rdfs:comment "An attribute, characteristic, or quality of the containing object expressed as a namespace qualified name/value pair." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:name ] ;
    sh:targetClass oscal:Property .

oscal:Link a sh:NodeShape ;
    rdfs:comment "A reference to a local or remote resource, that has a specific relation to the containing object." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Describes the type of relationship provided by the link's hypertext reference. This can be an indicator of the link's purpose." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "canonical" "alternate" "latest-version" "predecessor-version" "successor-version" "version-history" "reference" "source-profile" "source-profile-uuid" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:rel ],
        [ sh:datatype xsd:string ;
            sh:description "A label that indicates the nature of a resource, as a data serialization or format." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:media_type ],
        [ sh:datatype xsd:string ;
            sh:description "In case where the href points to a back-matter/resource, this value will indicate the URI fragment to append to any rlink associated with the resource. This value MUST be URI encoded." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:resource_fragment ],
        [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label to associate with the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:text ] ;
    sh:targetClass oscal:Link .

