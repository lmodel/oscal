            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ImportAssessmentPlan .

oscal:ImportComponentDefinition a sh:NodeShape ;
    rdfs:comment "Loads a component definition from another resource." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
