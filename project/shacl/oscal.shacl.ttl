            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ],
        [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ] ;
    sh:targetClass oscal:ImportProfile .

oscal:IncorporatesComponent a sh:NodeShape ;
    rdfs:comment "The collection of components comprising a capability." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "A UUID reference to a component." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:component_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:IncorporatesComponent .

oscal:InformationType a sh:NodeShape ;
    rdfs:comment "Contains details about one information type that is stored, processed, or transmitted by the system, such as privacy information, and its impact level." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:class oscal:InformationTypeCategorization ;
            sh:description "A set of information type identifiers qualified by the given identification system used." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:categorizations ],
        [ sh:class oscal:ImpactLevel ;
            sh:description "The expected level of impact resulting from the unauthorized modification of the described information." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:integrity_impact ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ],
        [ sh:class oscal:ImpactLevel ;
            sh:description "The expected level of impact resulting from the disruption of access to or use of the described information or the information system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:availability_impact ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:ImpactLevel ;
            sh:description "The expected level of impact resulting from the unauthorized disclosure of the described information." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:confidentiality_impact ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ] ;
    sh:targetClass oscal:InformationType .

oscal:InformationTypeCategorization a sh:NodeShape ;
    rdfs:comment "A set of information type identifiers qualified by the given identification system used." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Specifies the information type identification system used. Recommended values are in InformationTypeCategorizationSystemEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "http://doi.org/10.6028/NIST.SP.800-60v2r1" ) ] [ sh:nodeKind sh:IRI ] ) ;
            sh:order 0 ;
            sh:path oscal:system ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier qualified by the given identification system used, such as NIST SP 800-60." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:information_type_ids ] ;
    sh:targetClass oscal:InformationTypeCategorization .

oscal:InheritedControlImplementation a sh:NodeShape ;
    rdfs:comment "Describes a control implementation inherited by a leveraging system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Machine-oriented identifier reference to an inherited control implementation that a leveraging system is implementing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:provided_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:SspByComponentResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:responsible_roles ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:InheritedControlImplementation .

oscal:LeveragedAuthorization a sh:NodeShape ;
    rdfs:comment "A description of another authorized system from which this system inherits capabilities that satisfy security requirements. Another term for this concept is a common control provider." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented identifier reference to the party who is making the log entry." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:party_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:SspLeveragedAuthorizationLink ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "The date the system received its authorization." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:date_authorized ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:LeveragedAuthorization .

oscal:LocalDefinitions a sh:NodeShape ;
    rdfs:comment "Used to define data objects that are used in the assessment plan, that do not appear in the referenced SSP." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:InventoryItem ;
            sh:description "A collection of inventory items." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:inventory_items ],
        [ sh:class oscal:SystemComponent ;
            sh:description "A collection of system components." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:components ],
        [ sh:class oscal:SystemUser ;
            sh:description "A collection of system users." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:users ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:LocalObjective ;
            sh:description "A collection of locally-defined control objectives." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:objectives_and_methods ],
        [ sh:class oscal:Activity ;
            sh:description "A collection of activities." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:activities ] ;
    sh:targetClass oscal:LocalDefinitions .

oscal:Location a sh:NodeShape ;
    rdfs:comment "A physical point of presence, which may be associated with people, organizations, or other concepts within the current or linked OSCAL document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:LocationProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:props ],
        [ sh:class oscal:TelephoneNumber ;
            sh:description "Telephone numbers associated with the containing object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:telephone_numbers ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "Email addresses associated with the containing object." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:email_addresses ;
            sh:pattern "^.+@.+$" ],
        [ sh:class oscal:Address ;
            sh:description "A postal address for the location." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:address ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:links ],
        [ sh:description "The uniform resource locator (URL) for a web site or other resource associated with the location." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path oscal:urls ] ;
    sh:targetClass oscal:Location .

oscal:LocationProperty a sh:NodeShape ;
    rdfs:comment "Location-scoped OSCAL property." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:in ( "type" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "data-center" "region" "zone" "headquarters" "regional-office" "satellite-office" "edge" "cdn" "domain" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "primary" "alternate" "peer" "availability" "sub" "fault" "failure" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 4 ;
            sh:path oscal:_class ] ;
    sh:targetClass oscal:LocationProperty .

oscal:Map a sh:NodeShape ;
    rdfs:comment "A relationship-based mapping entry between source and target sets." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "An optional namespace qualifying a name. Allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oscal:ns ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:props ],
        [ sh:class oscal:QualifierItem ;
            sh:description "Qualifier statements for a mapping entry." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:qualifiers ],
        [ sh:description "The rationale method used to relate mapped items." ;
            sh:in ( "syntactic" "semantic" "functional" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path oscal:matching_rationale ],
        [ sh:class oscal:MappingItem ;
            sh:description "Source references or source-participation entries in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:sources ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:description "Relationship type for a mapping entry. OSCAL namespace values are defined by RelationshipEnum." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "equivalent-to" "equal-to" "subset-of" "superset-of" "intersects-with" "no-relationship" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path oscal:relationship ],
        [ sh:class oscal:Coverage ;
            sh:description "Coverage metadata for a mapping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:coverage ],
        [ sh:class oscal:MappingItem ;
            sh:description "Target subjects participating in a mapping entry." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:targets ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:links ],
        [ sh:class oscal:ConfidenceScore ;
            sh:description "Confidence descriptor for a mapping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:confidence_score ] ;
    sh:targetClass oscal:Map .

oscal:Mapping a sh:NodeShape ;
    rdfs:comment "A mapping between two mapped resources." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:MappingResourceReference ;
            sh:description "Reference to the mapping source resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:source_resource ],
        [ sh:description "Status indicator used by the containing OSCAL context. Allowed values are constrained by class-level slot_usage." ;
            sh:in ( "complete" "not-complete" "draft" "deprecated" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path oscal:status ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the context and intended use of the mapping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:mapping_description ],
        [ sh:class oscal:GapSummary ;
            sh:description "Summary of unmapped source controls." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:source_gap_summary ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:description "Method indicator used by the containing OSCAL context. Allowed values are constrained by class-level slot_usage." ;
            sh:in ( "human" "automation" "hybrid" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path oscal:method ],
        [ sh:class oscal:MappingResourceReference ;
            sh:description "Reference to the mapping target resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:target_resource ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path oscal:props ],
        [ sh:class oscal:GapSummary ;
            sh:description "Summary of unmapped target controls." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:target_gap_summary ],
        [ sh:description "The rationale method used to relate mapped items." ;
            sh:in ( "syntactic" "semantic" "functional" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path oscal:matching_rationale ],
        [ sh:class oscal:Coverage ;
            sh:description "Coverage metadata for a mapping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:coverage ],
        [ sh:class oscal:ConfidenceScore ;
            sh:description "Confidence descriptor for a mapping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:confidence_score ],
        [ sh:class oscal:Map ;
            sh:description "Mapping entries relating source items to target items." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:maps ] ;
    sh:targetClass oscal:Mapping .

oscal:MappingCollection a sh:NodeShape ;
    rdfs:comment "A collection of control mappings between source and target resources." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:MappingProvenance ;
            sh:description "Global provenance and mapping method metadata." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:provenance ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Mapping ;
            sh:description "A collection of control mappings." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:mappings ],
        [ sh:class oscal:Metadata ;
            sh:description "Provides information about the containing document, and defines concepts shared across the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:metadata ],
        [ sh:class oscal:BackMatter ;
            sh:description "A collection of resources that may be referenced from within the OSCAL document instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:back_matter ] ;
    sh:targetClass oscal:MappingCollection .

oscal:MappingProvenance a sh:NodeShape ;
    rdfs:comment "Mapping-level provenance details and mapping defaults." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:ConfidenceScore ;
            sh:description "Confidence descriptor for a mapping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:confidence_score ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the context and intended use of the mapping." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:mapping_description ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:props ],
        [ sh:class oscal:ResponsibleParty ;
            sh:description "Responsible party assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:responsible_parties ],
        [ sh:description "Method indicator used by the containing OSCAL context. Allowed values are constrained by class-level slot_usage." ;
            sh:in ( "human" "automation" "hybrid" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:method ],
        [ sh:description "Status indicator used by the containing OSCAL context. Allowed values are constrained by class-level slot_usage." ;
            sh:in ( "complete" "not-complete" "draft" "deprecated" "superseded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path oscal:status ],
        [ sh:description "The rationale method used to relate mapped items." ;
            sh:in ( "syntactic" "semantic" "functional" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path oscal:matching_rationale ],
        [ sh:class oscal:Coverage ;
            sh:description "Coverage metadata for a mapping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:coverage ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:MappingProvenance .

oscal:MergeCustom a sh:NodeShape ;
    rdfs:comment "Provides an alternate grouping structure that selected controls will be placed in after profile resolution." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:InsertControls ;
            sh:description "Specifies which controls to use in the containing context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:insert_controls ],
        [ sh:class oscal:ProfileGroup ;
            sh:description "A collection of control groups." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:groups ] ;
    sh:targetClass oscal:MergeCustom .

oscal:MergeFlat a sh:NodeShape ;
    rdfs:comment "Directs that controls appear without any grouping structure after profile resolution." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass oscal:MergeFlat .

oscal:MetadataPartyExternalId a sh:NodeShape ;
    rdfs:comment "Metadata-scoped external identifier." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Indicates the type of external identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "http://orcid.org/" ) ] [ sh:nodeKind sh:IRI ] ) ;
            sh:order 0 ;
            sh:path oscal:scheme ],
        [ sh:datatype xsd:string ;
            sh:description "A unique human-oriented identifier within a particular context." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:id ] ;
    sh:targetClass oscal:MetadataPartyExternalId .

oscal:MetadataProperty a sh:NodeShape ;
    rdfs:comment "Metadata-scoped OSCAL property." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:in ( "keywords" "resolution-tool" "source-profile-uuid" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ] ;
    sh:targetClass oscal:MetadataProperty .

oscal:MitigatingFactor a sh:NodeShape ;
    rdfs:comment "Describes an existing mitigating factor that may affect the overall determination of the risk." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with cross-instance scope that can be used to reference this implementation statement elsewhere in this or other OSCAL instances." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:implementation_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:SubjectReference ;
            sh:description "Assessment subjects or subject references for this object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:subjects ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:MitigatingFactor .

oscal:NetworkArchitecture a sh:NodeShape ;
    rdfs:comment "A description of the system's network architecture, optionally supplemented with diagrams that illustrate the network architecture." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Diagram ;
            sh:description "A collection of diagrams that visually depict the subject." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:diagrams ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:description ] ;
    sh:targetClass oscal:NetworkArchitecture .

oscal:ObjectiveStatus a sh:NodeShape ;
    rdfs:comment "A determination of if the objective is satisfied or not within a given system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "An indication as to whether the objective is satisfied or not." ;
            sh:in ( "satisfied" "not-satisfied" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:state ],
        [ sh:description "The reason the objective was given its status. Recommended values are in ObjectiveStatusReasonEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "pass" "fail" "other" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:reason ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ObjectiveStatus .

oscal:OnDateCondition a sh:NodeShape ;
    rdfs:comment "The task is intended to occur on the specified date." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time when the action occurred." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:date ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ] ;
    sh:targetClass oscal:OnDateCondition .

oscal:OriginActor a sh:NodeShape ;
    rdfs:comment "The actor that produces an observation, a finding, or a risk." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Indicates the nature or kind of the containing object." ;
            sh:in ( "tool" "assessment-platform" "party" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:type ],
        [ sh:datatype xsd:string ;
            sh:description "A reference to a role by its identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:role_id ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented identifier reference to the tool or person based on the associated type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:actor_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:OriginActor .

oscal:ParameterProperty a sh:NodeShape ;
    rdfs:comment "Control-common parameter-scoped OSCAL property." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "label" "sort-id" "alt-identifier" "alt-label" ) ] [ sh:in ( "aggregates" ) ] ) ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:ParameterProperty .

oscal:ParameterSetting a sh:NodeShape ;
    rdfs:comment "A parameter setting to be propagated to points of insertion in a resolved profile." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Describes the purpose and use of a parameter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:usage ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A short, placeholder name for the parameter, which can be used as a substitute for a value if no value is assigned." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:label ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:_class ],
        [ sh:class oscal:ParameterSelection ;
            sh:description "Presenting a choice among alternatives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:select ],
        [ sh:class oscal:ParameterGuideline ;
            sh:description "A prose statement that provides a recommendation for the use of a parameter." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:guidelines ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:props ],
        [ sh:class oscal:ParameterConstraint ;
            sh:description "A formal or informal expression of a constraint or test." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:constraints ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier for the parameter being set or referenced." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:param_id ],
        [ sh:datatype xsd:string ;
            sh:description "A parameter value or set of values." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:values ],
        [ sh:datatype xsd:string ;
            sh:description "(deprecated) Another parameter invoking this one. This construct has been deprecated and should not be used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:depends_on ] ;
    sh:targetClass oscal:ParameterSetting .

oscal:PartProperty a sh:NodeShape ;
    rdfs:comment "Control-common part-scoped OSCAL property." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:in ( "label" "sort-id" "alt-identifier" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ] ;
    sh:targetClass oscal:PartProperty .

oscal:Party a sh:NodeShape ;
    rdfs:comment "An organization or person, which may be associated with roles or other concepts within the current or linked OSCAL document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:MetadataPartyExternalId ;
            sh:description "An identifier for a person or organization using a designated scheme, e.g. an Open Researcher and Contributor ID (ORCID)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:external_ids ],
        [ sh:datatype xsd:string ;
            sh:description "Email addresses associated with the containing object." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:email_addresses ;
            sh:pattern "^.+@.+$" ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A reference to another party by UUID, typically an organization, that this subject is associated with." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path oscal:member_of_organizations ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path oscal:links ],
        [ sh:class oscal:PartyProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A short common name, abbreviation, or acronym." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:short_name ],
        [ sh:description "A category describing the kind of party the object describes." ;
            sh:in ( "person" "organization" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path oscal:type ],
        [ sh:datatype xsd:string ;
            sh:description "The full name of the party." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:name ],
        [ sh:class oscal:Address ;
            sh:description "Postal addresses associated with the containing object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:addresses ],
        [ sh:class oscal:TelephoneNumber ;
            sh:description "Telephone numbers associated with the containing object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:telephone_numbers ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to a location by UUID." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path oscal:location_uuids ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:Party .

oscal:PartyProperty a sh:NodeShape ;
    rdfs:comment "Party-scoped OSCAL property." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:in ( "mail-stop" "office" "job-title" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ] ;
    sh:targetClass oscal:PartyProperty .

oscal:PlanOfActionAndMilestones a sh:NodeShape ;
    rdfs:comment "A plan of action and milestones that identifies initial and residual risks, deviations, and disposition." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Risk ;
            sh:description "A collection of risks captured in the containing context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:risks ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:BackMatter ;
            sh:description "A collection of resources that may be referenced from within the OSCAL document instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:back_matter ],
        [ sh:class oscal:PoamItem ;
            sh:description "A collection of POA&M items." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:poam_items ],
        [ sh:class oscal:Observation ;
            sh:description "A collection of observations captured in the containing context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:observations ],
        [ sh:class oscal:SystemId ;
            sh:description "A human-oriented, globally unique identifier for a system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:system_id ],
        [ sh:class oscal:PoamLocalDefinitions ;
            sh:description "Used to define data objects that do not appear in the referenced SSP." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:local_definitions ],
        [ sh:class oscal:Finding ;
            sh:description "A collection of findings captured in the containing context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:findings ],
        [ sh:class oscal:ImportSSP ;
            sh:description "Used to import information about the system from an SSP." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:import_ssp ],
        [ sh:class oscal:Metadata ;
            sh:description "Provides information about the containing document, and defines concepts shared across the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:metadata ] ;
    sh:targetClass oscal:PlanOfActionAndMilestones .

oscal:PoamItem a sh:NodeShape ;
    rdfs:comment "Describes an individual POA&M item." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Origin ;
            sh:description "Identifies the source of observations, findings, or risks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:origins ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:RelatedFinding ;
            sh:description "Relates a POA&M item to one or more findings." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:related_findings ],
        [ sh:class oscal:AssociatedRisk ;
            sh:description "Relates the finding to a set of referenced risks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:related_risks ],
        [ sh:class oscal:RelatedObservation ;
            sh:description "Relates the containing object to a set of referenced observations." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:related_observations ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:PoamItem .

oscal:PoamLocalDefinitions a sh:NodeShape ;
    rdfs:comment "Allows components and inventory items to be defined within the POA&M for cases where no OSCAL SSP is available with the POA&M." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SystemComponent ;
            sh:description "A collection of system components." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:components ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:InventoryItem ;
            sh:description "A collection of inventory items." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:inventory_items ],
        [ sh:class oscal:AssessmentAssets ;
            sh:description "Identifies the assets used to perform this assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:assessment_assets ] ;
    sh:targetClass oscal:PoamLocalDefinitions .

oscal:PortRange a sh:NodeShape ;
    rdfs:comment "Where applicable, the transport layer protocol port range." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "The end date/time." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:end ],
        [ sh:description "Indicates the transport type." ;
            sh:in ( "TCP" "UDP" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path oscal:transport ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "The start date/time." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:start ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:PortRange .

oscal:Profile a sh:NodeShape ;
    rdfs:comment "An OSCAL Profile that designates a set of controls from one or more catalogs or profiles, optionally restructures and modifies them, to describe a basis for a security standard or body of practice." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:BackMatter ;
            sh:description "A collection of resources that may be referenced from within the OSCAL document instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:back_matter ],
        [ sh:class oscal:ProfileModify ;
            sh:description "Set parameters or amend controls in resolution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:modify ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:ProfileMerge ;
            sh:description "Structuring directives for how controls are organized after profile resolution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:merge ],
        [ sh:class oscal:Metadata ;
            sh:description "Provides information about the containing document, and defines concepts shared across the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:metadata ],
        [ sh:class oscal:ProfileImport ;
            sh:description "Designates source catalog or profile resources to be imported into the profile." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:imports ] ;
    sh:targetClass oscal:Profile .

oscal:ProfileAlterationProperty a sh:NodeShape ;
    rdfs:comment "OSCAL property entries allowed in profile modify additions." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ],
        [ sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:in ( "label" "sort-id" "alt-identifier" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ] ;
    sh:targetClass oscal:ProfileAlterationProperty .

oscal:ProfileImport a sh:NodeShape ;
    rdfs:comment "Designates a referenced source catalog or profile that provides a source of control information for use in creating a new overlay or baseline." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ],
        [ sh:class oscal:SelectControlById ;
            sh:description "Control-selection entries to exclude in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:exclude_controls ],
        [ sh:class oscal:IncludeAll ;
            sh:description "Include all selectable objects in the containing OSCAL selection context." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:include_all ],
        [ sh:class oscal:SelectControlById ;
            sh:description "Control-selection entries to include in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:include_controls ] ;
    sh:targetClass oscal:ProfileImport .

oscal:ProfileMerge a sh:NodeShape ;
    rdfs:comment "Provides structuring directives that instruct how controls are organized after profile resolution." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:CombinationRule ;
            sh:description "Defines how to resolve duplicate instances of the same control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:combine ],
        [ sh:class oscal:MergeCustom ;
            sh:description "Provides an alternate grouping structure that selected controls will be placed in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:custom ],
        [ sh:class oscal:MergeFlat ;
            sh:description "Directs that controls appear without any grouping structure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:flat ],
        [ sh:datatype xsd:boolean ;
            sh:description "When true, retain the original grouping structure as defined in the import source." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:as_is ] ;
    sh:targetClass oscal:ProfileMerge .

oscal:ProfileModify a sh:NodeShape ;
    rdfs:comment "Set parameters or amend controls in resolution." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:ParameterSetting ;
            sh:description "A parameter setting to be propagated to points of insertion." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:set_parameters ],
        [ sh:class oscal:Alteration ;
            sh:description "Specifies changes to be made to included controls in resolution." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:alters ] ;
    sh:targetClass oscal:ProfileModify .

oscal:ProvidedControlImplementation a sh:NodeShape ;
    rdfs:comment "Describes a capability which may be inherited by a leveraging system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:props ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ],
        [ sh:class oscal:SspByComponentResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:responsible_roles ] ;
    sh:targetClass oscal:ProvidedControlImplementation .

oscal:QualifierItem a sh:NodeShape ;
    rdfs:comment "A qualifier describing requirements or incompatibilities." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Confidence category label or qualifier category value." ;
            sh:in ( "restricted" "addressable" "blocked" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path oscal:category ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:description ],
        [ sh:description "Subject to which the qualifier applies." ;
            sh:in ( "source" "target" "both" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:subject ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ],
        [ sh:description "Predicate describing qualifier semantics." ;
            sh:in ( "has-requirement" "has-incompatibility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path oscal:predicate ] ;
    sh:targetClass oscal:QualifierItem .

oscal:RelatedFinding a sh:NodeShape ;
    rdfs:comment "Relates a POA&M item to a referenced finding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A UUID reference to a finding." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:finding_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:RelatedFinding .

oscal:RelevantEvidence a sh:NodeShape ;
    rdfs:comment "Links this observation to relevant evidence." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:description ] ;
    sh:targetClass oscal:RelevantEvidence .

oscal:Removal a sh:NodeShape ;
    rdfs:comment "Specifies objects to be removed from a control based on aspects of the object that must all match." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "Identify or target items by their id value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:by_id ],
        [ sh:datatype xsd:string ;
            sh:description "Identify items to remove by their assigned name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:by_name ],
        [ sh:datatype xsd:string ;
            sh:description "Identify items to remove by their class label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:by_class ],
        [ sh:description "Identify items to remove by the item's information object type name." ;
            sh:in ( "param" "prop" "link" "part" "mapping" "map" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path oscal:by_item_name ],
        [ sh:description "Identify items to remove by the item's namespace." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path oscal:by_ns ] ;
    sh:targetClass oscal:Removal .

oscal:RequiredAsset a sh:NodeShape ;
    rdfs:comment "Identifies an asset required to achieve remediation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:props ],
        [ sh:class oscal:SubjectReference ;
            sh:description "Assessment subjects or subject references for this object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:subjects ] ;
    sh:targetClass oscal:RequiredAsset .

oscal:Resource a sh:NodeShape ;
    rdfs:comment "A resource associated with content in the containing document instance. A resource may be directly included in the document using base64 encoding or may point to one or more equivalent internet resources." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:DocumentId ;
            sh:description "Document identifiers qualified by an identifier scheme." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:document_ids ],
        [ sh:class oscal:Citation ;
            sh:description "An optional citation consisting of end note text using structured markup." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:citation ],
        [ sh:class oscal:ResourceLink ;
            sh:description "A URL-based pointer to an external resource with an optional hash for verification and change detection." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:rlinks ],
        [ sh:class oscal:ResourceProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "An optional short summary of the resource used to indicate the purpose of the resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:class oscal:Base64Resource ;
            sh:description "A resource encoded using the Base64 alphabet defined by RFC 2045." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:base64 ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "An optional name given to the resource, which may be used by a tool for display and navigation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:Resource .

oscal:ResourceLink a sh:NodeShape ;
    rdfs:comment "A URL-based pointer to an external resource with an optional hash for verification and change detection." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A label that indicates the nature of a resource, as a data serialization or format." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:media_type ],
        [ sh:class oscal:Hash ;
            sh:description "A representation of a cryptographic digest generated over a resource using a specified hash algorithm." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:hashes ],
        [ sh:description "A resolvable URL pointing to the referenced resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ] ;
    sh:targetClass oscal:ResourceLink .

oscal:ResourceProperty a sh:NodeShape ;
    rdfs:comment "Back-matter resource-scoped OSCAL property." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "logo" "image" "screen-shot" "law" "regulation" "standard" "external-guidance" "acronyms" "citation" "policy" "procedure" "system-guide" "users-guide" "administrators-guide" "rules-of-behavior" "plan" "artifact" "evidence" "tool-output" "raw-data" "interview-notes" "questionnaire" "report" "agreement" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:in ( "type" "version" "published" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ResourceProperty .

oscal:Response a sh:NodeShape ;
    rdfs:comment "Describes either recommended or an actual plan for addressing the risk." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:description "Identifies whether this is a recommendation or an actual plan. Recommended values are in ResponseLifecycleEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "recommendation" "planned" "completed" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path oscal:lifecycle ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:class oscal:Task ;
            sh:description "A collection of tasks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:tasks ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:RequiredAsset ;
            sh:description "Identifies an asset required to achieve remediation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:required_assets ],
        [ sh:class oscal:Origin ;
            sh:description "Identifies the source of observations, findings, or risks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:origins ] ;
    sh:targetClass oscal:Response .

oscal:Result a sh:NodeShape ;
    rdfs:comment "Identifies all of the assessment observations and findings, initial and residual risks, deviations, and disposition for a particular execution of the assessment." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Attestation ;
            sh:description "A set of attestation statements for the result." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:attestations ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:class oscal:Risk ;
            sh:description "A collection of risks captured in the containing context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:risks ],
        [ sh:class oscal:AssessmentLog ;
            sh:description "A log of assessment-related actions taken." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path oscal:assessment_log ],
        [ sh:class oscal:ResultLocalDefinitions ;
            sh:description "Used to define data objects that do not appear in the referenced SSP." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:local_definitions ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The end date/time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:end ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The start date/time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:start ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:class oscal:Observation ;
            sh:description "A collection of observations captured in the containing context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:observations ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:ReviewedControls ;
            sh:description "Identifies the controls being assessed and their control objectives." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:reviewed_controls ],
        [ sh:class oscal:Finding ;
            sh:description "A collection of findings captured in the containing context." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path oscal:findings ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ;
    sh:targetClass oscal:Result .

oscal:ResultLocalDefinitions a sh:NodeShape ;
    rdfs:comment "Used to define local implementation and assessment assets referenced by a result that do not appear in the imported system security plan." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SystemComponent ;
            sh:description "A collection of system components." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:components ],
        [ sh:class oscal:AssessmentAssets ;
            sh:description "Identifies the assets used to perform this assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:assessment_assets ],
        [ sh:class oscal:InventoryItem ;
            sh:description "A collection of inventory items." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:inventory_items ],
        [ sh:class oscal:Task ;
            sh:description "A collection of tasks." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:tasks ],
        [ sh:class oscal:SystemUser ;
            sh:description "A collection of system users." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:users ] ;
    sh:targetClass oscal:ResultLocalDefinitions .

oscal:Revision a sh:NodeShape ;
    rdfs:comment "An entry in a sequential list of revisions to the containing document." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The OSCAL model version the document was authored against and will conform to as valid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:oscal_version ],
        [ sh:datatype xsd:string ;
            sh:description "Used to distinguish a specific revision of an OSCAL document from other previous and future versions." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:version ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time the document was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:last_modified ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:title ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time the document was last made available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:published ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:class oscal:RevisionProperty ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:Revision .

oscal:RevisionProperty a sh:NodeShape ;
    rdfs:comment "Revision-scoped OSCAL property." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the value of the attribute, characteristic, or quality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:value ],
        [ sh:description "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oscal:ns ],
        [ sh:description "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object." ;
            sh:in ( "marking" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oscal:name ],
        [ sh:datatype xsd:string ;
            sh:description "An identifier for relating distinct sets of properties." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:group ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for a property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label that provides a sub-type or characterization of the property's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:_class ] ;
    sh:targetClass oscal:RevisionProperty .

oscal:RiskLog a sh:NodeShape ;
    rdfs:comment "A log of all risk-related tasks taken." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:RiskLogEntry ;
            sh:description "Identifies an individual risk response that occurred as part of managing an identified risk." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:entries ] ;
    sh:targetClass oscal:RiskLog .

oscal:RiskLogEntry a sh:NodeShape ;
    rdfs:comment "Identifies an individual risk response that occurred as part of managing an identified risk." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:RiskResponseReference ;
            sh:description "Identifies an individual risk response that this log entry is for." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oscal:related_responses ],
        [ sh:class oscal:LoggedBy ;
            sh:description "Used to indicate who created a log entry in what role." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:logged_by ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The end date/time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:end ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:description "Identifies the risk change that prompted the log entry. Recommended values are in RiskStatusEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "open" "investigating" "remediating" "deviation-requested" "deviation-approved" "closed" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 6 ;
            sh:path oscal:status_change ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The start date/time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:start ;
            sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:RiskLogEntry .

oscal:RiskResponseReference a sh:NodeShape ;
    rdfs:comment "Identifies an individual risk response that this log entry is for." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A machine-oriented identifier reference to a unique risk response." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:response_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:RelatedTask ;
            sh:description "Identifies tasks for which the containing object is a consequence." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:related_tasks ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ] ;
    sh:targetClass oscal:RiskResponseReference .

oscal:Role a sh:NodeShape ;
    rdfs:comment "Defines a function, which might be assigned to a party in a specific situation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the role." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:id ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:description "A short common name, abbreviation, or acronym." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:short_name ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:props ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:description ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:title ] ;
    sh:targetClass oscal:Role .

oscal:SatisfiedControlImplementation a sh:NodeShape ;
    rdfs:comment "Describes how this system satisfies a responsibility imposed by a leveraged system." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Machine-oriented identifier reference to a control implementation responsibility imposed by a leveraged system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:responsibility_uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:props ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:SspByComponentResponsibleRole ;
            sh:description "Responsible role assignments." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:responsible_roles ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:links ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:description ] ;
    sh:targetClass oscal:SatisfiedControlImplementation .

oscal:SecurityImpactLevel a sh:NodeShape ;
    rdfs:comment "The overall level of expected impact resulting from unauthorized disclosure, modification, or loss of access to information." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A target-level of integrity for the system, based on the sensitivity of information within the system." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:security_objective_integrity ],
        [ sh:datatype xsd:string ;
            sh:description "A target-level of availability for the system, based on the sensitivity of information within the system." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:security_objective_availability ],
        [ sh:datatype xsd:string ;
            sh:description "A target-level of confidentiality for the system, based on the sensitivity of information within the system." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:security_objective_confidentiality ] ;
    sh:targetClass oscal:SecurityImpactLevel .

oscal:SspByComponentLink a sh:NodeShape ;
    rdfs:comment "SSP-scoped link used in by-component contexts." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "In case where the href points to a back-matter/resource, this value will indicate the URI fragment to append to any rlink associated with the resource. This value MUST be URI encoded." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oscal:resource_fragment ],
        [ sh:description "A resolvable URL reference to a resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oscal:href ],
        [ sh:datatype xsd:string ;
            sh:description "A textual label to associate with the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path oscal:text ],
        [ sh:datatype xsd:string ;
            sh:description "A label that indicates the nature of a resource, as a data serialization or format." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path oscal:media_type ],
        [ sh:description "Describes the type of relationship provided by the link's hypertext reference. This can be an indicator of the link's purpose." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "imported-from" "provided-by" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path oscal:rel ] ;
    sh:targetClass oscal:SspByComponentLink .

oscal:SspControlImplementation a sh:NodeShape ;
    rdfs:comment "Describes how the system satisfies a set of controls." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:SetParameter ;
            sh:description "Identifies the parameter that will be set by the enclosed value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:set_parameters ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:description ],
        [ sh:class oscal:SspImplementedRequirement ;
            sh:description "Control implementation requirement entries in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
            sh:minCount 1 ;
