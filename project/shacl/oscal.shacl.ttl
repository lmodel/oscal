            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:props ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:links ] ;
    sh:targetClass oscal:Citation .

oscal:CombinationRule a sh:NodeShape ;
    rdfs:comment "Defines how to resolve duplicate instances of the same control (e.g., controls with the same ID) encountered in a profile merge." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Method indicator used by the containing OSCAL context. Allowed values are constrained by class-level slot_usage." ;
            sh:in ( "use-first" "merge" "keep" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path oscal:method ] ;
    sh:targetClass oscal:CombinationRule .

oscal:ComponentDefinition a sh:NodeShape ;
    rdfs:comment "A collection of component descriptions, which may optionally be grouped by capability." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:DefinedComponent ;
            sh:description "A collection of system components." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:components ],
        [ sh:class oscal:Metadata ;
            sh:description "Provides information about the containing document, and defines concepts shared across the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:metadata ],
        [ sh:datatype xsd:string ;
            sh:description "A machine-oriented, globally unique identifier with a cross-instance scope." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:BackMatter ;
            sh:description "A collection of resources that may be referenced from within the OSCAL document instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:back_matter ],
        [ sh:class oscal:Capability ;
            sh:description "Capability groupings for the defined components." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oscal:capabilities ],
        [ sh:class oscal:ImportComponentDefinition ;
            sh:description "Component-definition resources imported into this document." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:import_component_definitions ] ;
    sh:targetClass oscal:ComponentDefinition .

oscal:ConstraintTest a sh:NodeShape ;
    rdfs:comment "A test expression which is expected to be evaluated by a tool." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A formal (executable) expression of a constraint." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path oscal:expression ],
        [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ConstraintTest .

oscal:ControlMatching a sh:NodeShape ;
    rdfs:comment "Selecting a set of controls by matching their IDs with a wildcard pattern." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Additional commentary about the containing object." ;
