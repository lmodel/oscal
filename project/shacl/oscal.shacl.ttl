            sh:order 4 ;
            sh:path oscal:controls ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a globally unique means to identify a given catalog instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path oscal:uuid ;
            sh:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ],
        [ sh:class oscal:Group ;
            sh:description "A collection of control groups." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oscal:groups ],
        [ sh:class oscal:Metadata ;
            sh:description "Provides information about the containing document, and defines concepts shared across the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:metadata ],
        [ sh:class oscal:Parameter ;
            sh:description "Parameters providing a mechanism for the dynamic assignment of value(s) in a control." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:params ] ;
    sh:targetClass oscal:Catalog .

oscal:Characterization a sh:NodeShape ;
    rdfs:comment "A collection of descriptive data about the containing object from a specific origin." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oscal:Origin ;
            sh:description "The source of the finding." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oscal:origin ],
        [ sh:class oscal:Property ;
            sh:description "A list of properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oscal:props ],
        [ sh:class oscal:Link ;
            sh:description "A list of links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oscal:links ],
        [ sh:class oscal:Facet ;
            sh:description "An individual characteristic that is part of a larger set produced by the same actor." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oscal:facets ] ;
    sh:targetClass oscal:Characterization .

oscal:Citation a sh:NodeShape ;
    rdfs:comment "An optional citation consisting of end note text using structured markup." ;
    sh:closed true ;
