oscal:PartyExternalId a owl:Class ;
    rdfs:label "PartyExternalId" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:PartyExternalIdSchemeEnum xsd:anyURI ) ] xsd:anyURI ) ] ;
            owl:onProperty oscal:scheme ] ;
    skos:definition "An identifier for a person or organization using a designated scheme, e.g. an Open Researcher and Contributor ID (ORCID)." ;
    skos:inScheme oscal:oscal_catalog .

