oscal:OscalCommon a owl:Class ;
    rdfs:label "OscalCommon" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:remarks ],
        oscal:HasPropsAndLinks ;
    skos:definition "Mixin providing props, links, and remarks slots common to most OSCAL objects. Extends HasPropsAndLinks." ;
    skos:inScheme oscal:oscal_catalog .

oscal:links a owl:ObjectProperty ;
    rdfs:label "links" ;
    rdfs:range oscal:Link ;
    skos:definition "A list of links." ;
    skos:inScheme oscal:oscal_catalog .

oscal:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "A textual label that uniquely identifies an attribute or semantic type." ;
    skos:inScheme oscal:oscal_catalog .

oscal:props a owl:ObjectProperty ;
    rdfs:label "props" ;
    rdfs:range oscal:Property ;
    skos:definition "A list of properties." ;
    skos:inScheme oscal:oscal_catalog .

oscal:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable name or title." ;
    skos:inScheme oscal:oscal_catalog .

oscal:remarks a owl:DatatypeProperty ;
    rdfs:label "remarks" ;
    rdfs:range xsd:string ;
    skos:definition "Additional commentary about the containing object." ;
    skos:inScheme oscal:oscal_catalog .

oscal:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable description." ;
    skos:inScheme oscal:oscal_catalog .

oscal:uuid a owl:DatatypeProperty ;
    rdfs:label "uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A machine-oriented, globally unique identifier with a cross-instance scope." ;
    skos:inScheme oscal:oscal_catalog .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[45][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^.+@.+$" ] ) ] .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oscal:location_uuids ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty oscal:addresses ;
                owl:someValuesFrom owl:Thing ] oscal:Party ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oscal:addresses ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty oscal:location_uuids ;
                owl:someValuesFrom xsd:string ] oscal:Party ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oscal:values ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty oscal:select ;
                owl:someValuesFrom owl:Thing ] oscal:Parameter ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oscal:select ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty oscal:values ;
                owl:someValuesFrom xsd:string ] oscal:Parameter ) .


