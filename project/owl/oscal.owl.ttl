oscal:ImportAssessmentPlan a owl:Class ;
    rdfs:label "ImportAssessmentPlan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:remarks ] ;
    skos:definition "Used by assessment-results to import information about the original plan for assessing the system." ;
    skos:inScheme oscal:oscal_assessment_results .

oscal:ImportComponentDefinition a owl:Class ;
    rdfs:label "ImportComponentDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:href ] ;
    skos:definition "Loads a component definition from another resource." ;
    skos:inScheme oscal:oscal_component .

oscal:ImportProfile a owl:Class ;
    rdfs:label "ImportProfile" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:href ] ;
    skos:definition "Used to import the OSCAL profile representing the system's control baseline." ;
    skos:inScheme oscal:oscal_ssp .

oscal:IncorporatesComponent a owl:Class ;
    rdfs:label "IncorporatesComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:component_uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:component_uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:component_uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:description ] ;
    skos:definition "The collection of components comprising a capability." ;
    skos:inScheme oscal:oscal_component .

oscal:InformationType a owl:Class ;
    rdfs:label "InformationType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oscal:Link ;
            owl:onProperty oscal:links ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
