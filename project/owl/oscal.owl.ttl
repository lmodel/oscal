    linkml:permissible_values <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#accept>,
        <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#avoid>,
        <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#contingency>,
        <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#mitigate>,
        <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#none>,
        <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#share>,
        <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#transfer> ;
    oscal:oscal_allowed_values "oscal-response-prop-type-value" .

oscal:SystemIdentifierTypeEnum a owl:Class ;
    rdfs:label "SystemIdentifierTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/SystemIdentifierTypeEnum#http%3A%2F%2Ffedramp.gov> <https://w3id.org/lmodel/oscal/SystemIdentifierTypeEnum#http%3A%2F%2Ffedramp.gov%2Fns%2Foscal> <https://w3id.org/lmodel/oscal/SystemIdentifierTypeEnum#https%3A%2F%2Fietf.org%2Frfc%2Frfc4122> <https://w3id.org/lmodel/oscal/SystemIdentifierTypeEnum#http%3A%2F%2Fietf.org%2Frfc%2Frfc4122> <https://w3id.org/lmodel/oscal/SystemIdentifierTypeEnum#http%3A%2F%2Fdatatracker.ietf.org%2Fdoc%2Fhtml%2Frfc4122> ) ;
