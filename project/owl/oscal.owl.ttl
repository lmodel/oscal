oscal:ImplementedComponent a owl:Class ;
    rdfs:label "ImplementedComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:props ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ImplementationCommonLink ;
            owl:onProperty oscal:links ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:links ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:component_uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:component_uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:responsible_parties ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ImplementationResponsibleParty ;
            owl:onProperty oscal:responsible_parties ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ImplementationCommonProperty ;
            owl:onProperty oscal:props ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:component_uuid ],
        oscal:HasResponsibleParties,
        oscal:OscalCommon ;
    skos:definition "The set of components that are implemented in a given system inventory item." ;
    skos:inScheme oscal:oscal_assessment_plan .

