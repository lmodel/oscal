<https://w3id.org/lmodel/oscal.owl.ttl> a owl:Ontology ;
    rdfs:label "oscal" ;
    dcterms:license "Apache-2.0" ;
    dcterms:source <https://github.com/usnistgov/OSCAL/tree/e061961c7702afeabffdf5e59894d35e748dade1/src/metaschema> ;
    dcterms:title "Open Security Controls Assessment Language (OSCAL)" ;
    pav:version "1.2.3" ;
    rdfs:seeAlso <https://github.com/usnistgov/OSCAL/releases/tag/v1.2.3>,
        <https://lmodel.github.io/oscal>,
        <https://pages.nist.gov/OSCAL-Reference/models/v1.2.3/>,
        <https://pages.nist.gov/OSCAL/> ;
    skos:definition "A LinkML model of NIST's Open Security Controls Assessment Language (OSCAL) 1.2.3: the catalog, profile, component definition, system security plan, assessment plan, assessment results, plan of action and milestones, and mapping collection models, each in a module of its own." ;
    skos:editorialNote "A new UUID value must be generated and assigned to the root element's uuid.",
        "Every time the content of an OSCAL file changes, the following must also change:",
        "The last-modified field in metadata must be assigned with the date and time at the moment the file is saved with the modified content.",
        "These are two mechanisms by which tools can quickly know if a file has changed since it was last encountered. This document level UUID is the only UUID in OSCAL associated with version control.",
        "When converting between formats, such as XML to JSON, these values should remain the same. This enables tools to know the content within the two formats is equivalent." ;
    skos:note "The version is the OSCAL release the model renders. Its tag and commit are in the annotations, and src/oscal/schema/metaschema/ holds that commit's metaschema sources, where every allowed-values list an enum renders is defined; each enum's oscal_allowed_values annotation names its lists. scripts/check_upstream_release.py reads the same pins and reports when NIST tags a newer release or the copy drifts. The release tags are the schema's own versions." ;
    oscal:last-modified "2026-10-28T23:30:00Z" ;
    oscal:oscal_commit "e061961c7702afeabffdf5e59894d35e748dade1" ;
    oscal:oscal_tag "v1.2.3" ;
    oscal:uuid "5bda39c3-8ebf-4717-b21f-c96a20c27f18" .

oscal:AssessmentMethod a owl:Class ;
    rdfs:label "AssessmentMethod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:part ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:AssessmentPart ;
            owl:onProperty oscal:part ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:part ],
        oscal:OscalCommon ;
    skos:definition "A local definition of a control objective." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:AssessmentPlanDocument a owl:Class ;
    rdfs:label "AssessmentPlanDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oscal:AssessmentPlan ;
            owl:onProperty oscal:assessment_plan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:assessment_plan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:assessment_plan ],
        oscal:OscalDocument ;
    skos:definition "Root wrapper for an OSCAL Assessment Plan document." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:AssessmentResultsDocument a owl:Class ;
    rdfs:label "AssessmentResultsDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
