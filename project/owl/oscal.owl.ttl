oscal:HasPropsAndLinks a owl:Class ;
    rdfs:label "HasPropsAndLinks" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:props ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Link ;
            owl:onProperty oscal:links ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Property ;
            owl:onProperty oscal:props ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:links ] ;
    skos:definition "Mixin providing the props and links slots that are common to many OSCAL objects." ;
    skos:inScheme oscal:oscal_catalog .

