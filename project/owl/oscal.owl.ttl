xsd:dateTime a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ] ) ] .

oscal:Link a owl:Class ;
    rdfs:label "Link" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:text ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:MetadataLinkRelEnum xsd:string ) ] xsd:string ) ] ;
            owl:onProperty oscal:rel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:media_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:resource_fragment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:media_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:rel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:resource_fragment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:rel ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:media_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:resource_fragment ] ;
