            owl:onProperty oscal:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Response ;
            owl:onProperty oscal:remediations ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:MitigatingFactor ;
            owl:onProperty oscal:mitigating_factors ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:deadline ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:deadline ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty oscal:deadline ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Origin ;
            owl:onProperty oscal:origins ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:mitigating_factors ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:RiskLog ;
            owl:onProperty oscal:risk_log ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:remediations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Characterization ;
            owl:onProperty oscal:characterizations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:uuid ],
        oscal:HasPropsAndLinks ;
    skos:definition "An identified risk." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:SspControlOriginationProp a owl:Class ;
    rdfs:label "SspControlOriginationProp" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oscal:ControlOriginationPropNameEnum ;
            owl:onProperty oscal:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ControlOriginationValueEnum ;
            owl:onProperty oscal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:value ],
        oscal:Property ;
    skos:definition "SSP-scoped property used in implemented requirement and by-component contexts." ;
    skos:inScheme oscal:oscal_ssp .

oscal:SubjectReference a owl:Class ;
    rdfs:label "SubjectReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:subject_uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:SelectSubjectTypeEnum xsd:string ) ] xsd:string ) ] ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:subject_uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:subject_uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:title ],
        oscal:OscalCommon ;
    skos:definition "A human-oriented identifier reference to a resource. Use type to indicate whether the identified resource is a component, inventory item, location, user, or something else." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:TaskTypeEnum a owl:Class ;
    rdfs:label "TaskTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/TaskTypeEnum#milestone> <https://w3id.org/lmodel/oscal/TaskTypeEnum#action> ) ;
    skos:definition """Curated task type values. Other values are permitted (OSCAL allow-other="yes").
""" ;
    skos:inScheme oscal:oscal_assessment_plan ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/TaskTypeEnum#action>,
        <https://w3id.org/lmodel/oscal/TaskTypeEnum#milestone> ;
    oscal:allow_any true ;
    oscal:oscal_allowed_values "oscal-task-values" .

oscal:TelephoneNumber a owl:Class ;
    rdfs:label "TelephoneNumber" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:number ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:number ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:number ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:PhoneTypeEnum xsd:string ) ] xsd:string ) ] ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:type ] ;
    skos:definition "A telephone service number as defined by ITU-T E.164." ;
    skos:inScheme oscal:oscal_catalog .

oscal:activity_uuid a owl:DatatypeProperty ;
    rdfs:label "activity-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A UUID reference to an activity." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:actor_uuid a owl:DatatypeProperty ;
    rdfs:label "actor-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A machine-oriented identifier reference to the tool or person based on the associated type." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:address a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:range oscal:Address ;
    skos:definition "A postal address for the location." ;
    skos:inScheme oscal:oscal_catalog .

oscal:adjustment_justification a owl:DatatypeProperty ;
    rdfs:label "adjustment-justification" ;
    rdfs:range xsd:string ;
    skos:definition "If the selected security level is different from the base security level, this contains the justification for the change." ;
    skos:inScheme oscal:oscal_ssp .

oscal:algorithm a owl:DatatypeProperty ;
    rdfs:label "algorithm" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:HashAlgorithmEnum xsd:string ) ] ;
    skos:definition "The digest method by which a hash is derived. Recommended values are in HashAlgorithmEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_catalog .

oscal:as_is a owl:DatatypeProperty ;
    rdfs:label "as-is" ;
    rdfs:range xsd:boolean ;
    skos:definition "When true, retain the original grouping structure as defined in the import source." ;
    skos:inScheme oscal:oscal_profile .

oscal:assessment_log a owl:ObjectProperty ;
    rdfs:label "assessment-log" ;
    rdfs:range oscal:AssessmentLog ;
    skos:definition "A log of assessment-related actions taken." ;
    skos:inScheme oscal:oscal_assessment_results .

oscal:assessment_plan a owl:ObjectProperty ;
    rdfs:label "assessment-plan" ;
    rdfs:range oscal:AssessmentPlan ;
    skos:definition "The root assessment plan object." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:assessment_results a owl:ObjectProperty ;
    rdfs:label "assessment-results" ;
    rdfs:range oscal:AssessmentResults ;
    skos:definition "The root assessment results object." ;
    skos:inScheme oscal:oscal_assessment_results .

oscal:at_frequency a owl:ObjectProperty ;
    rdfs:label "at-frequency" ;
    rdfs:range oscal:AtFrequency ;
    skos:definition "The task is intended to occur at the specified frequency." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:authorization_boundary a owl:ObjectProperty ;
    rdfs:label "authorization-boundary" ;
    rdfs:range oscal:AuthorizationBoundary ;
    skos:definition "A description of this system's authorization boundary, optionally supplemented with diagrams that illustrate the authorization boundary." ;
    skos:inScheme oscal:oscal_ssp .

oscal:availability_impact a owl:ObjectProperty ;
    rdfs:label "availability-impact" ;
    rdfs:range oscal:ImpactLevel ;
    skos:definition "The expected level of impact resulting from the disruption of access to or use of the described information or the information system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:base a owl:DatatypeProperty ;
    rdfs:label "base" ;
    rdfs:range xsd:string ;
    skos:definition "The prescribed base (Confidentiality, Integrity, or Availability) security impact level." ;
    skos:inScheme oscal:oscal_ssp .

oscal:base64 a owl:ObjectProperty ;
    rdfs:label "base64" ;
    rdfs:range oscal:Base64Resource ;
    skos:definition "A resource encoded using the Base64 alphabet defined by RFC 2045." ;
    skos:inScheme oscal:oscal_catalog .

oscal:by_class a owl:DatatypeProperty ;
    rdfs:label "by-class" ;
    rdfs:range xsd:string ;
    skos:definition "Identify items to remove by their class label." ;
    skos:inScheme oscal:oscal_profile .

oscal:by_item_name a owl:ObjectProperty ;
    rdfs:label "by-item-name" ;
    rdfs:range oscal:ByItemNameEnum ;
    skos:definition "Identify items to remove by the item's information object type name." ;
    skos:inScheme oscal:oscal_profile .

oscal:by_name a owl:DatatypeProperty ;
    rdfs:label "by-name" ;
    rdfs:range xsd:string ;
    skos:definition "Identify items to remove by their assigned name." ;
    skos:inScheme oscal:oscal_profile .

oscal:by_ns a owl:DatatypeProperty ;
    rdfs:label "by-ns" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Identify items to remove by the item's namespace." ;
    skos:inScheme oscal:oscal_profile .

oscal:caption a owl:DatatypeProperty ;
    rdfs:label "caption" ;
    rdfs:range xsd:string ;
    skos:definition "A brief caption to annotate the diagram." ;
    skos:inScheme oscal:oscal_ssp .

oscal:catalog a owl:ObjectProperty ;
    rdfs:label "catalog" ;
    rdfs:range oscal:Catalog ;
    skos:definition "Root catalog document." ;
    skos:inScheme oscal:oscal_catalog .

oscal:citation a owl:ObjectProperty ;
    rdfs:label "citation" ;
    rdfs:range oscal:Citation ;
    skos:definition "An optional citation consisting of end note text using structured markup." ;
    skos:inScheme oscal:oscal_catalog .

oscal:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:range xsd:string ;
    skos:definition "City, town or geographical region for the mailing address." ;
    skos:inScheme oscal:oscal_catalog .

oscal:collected a owl:DatatypeProperty ;
    rdfs:label "collected" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date/time stamp identifying when the finding information was collected." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:combine a owl:ObjectProperty ;
    rdfs:label "combine" ;
    rdfs:range oscal:CombinationRule ;
    skos:definition "Defines how to resolve duplicate instances of the same control." ;
    skos:inScheme oscal:oscal_profile .

oscal:component_definition a owl:ObjectProperty ;
    rdfs:label "component-definition" ;
    rdfs:range oscal:ComponentDefinition ;
    skos:definition "The root component-definition object." ;
    skos:inScheme oscal:oscal_component .

oscal:confidentiality_impact a owl:ObjectProperty ;
    rdfs:label "confidentiality-impact" ;
    rdfs:range oscal:ImpactLevel ;
    skos:definition "The expected level of impact resulting from the unauthorized disclosure of the described information." ;
    skos:inScheme oscal:oscal_ssp .

oscal:control_implementation a owl:ObjectProperty ;
    rdfs:label "control-implementation" ;
    rdfs:range oscal:SspControlImplementation ;
    skos:definition "Describes how the system satisfies a set of controls." ;
    skos:inScheme oscal:oscal_ssp .

oscal:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:range xsd:string ;
    skos:definition "The ISO 3166-1 alpha-2 country code for the mailing address." ;
    skos:inScheme oscal:oscal_catalog .

oscal:custom a owl:ObjectProperty ;
    rdfs:label "custom" ;
    rdfs:range oscal:MergeCustom ;
    skos:definition "Provides an alternate grouping structure that selected controls will be placed in." ;
    skos:inScheme oscal:oscal_profile .

oscal:data_flow a owl:ObjectProperty ;
    rdfs:label "data-flow" ;
    rdfs:range oscal:DataFlow ;
    skos:definition "A description of the logical flow of information within the system and across its boundaries, optionally supplemented with diagrams." ;
    skos:inScheme oscal:oscal_ssp .

oscal:deadline a owl:DatatypeProperty ;
    rdfs:label "deadline" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date/time by which the risk must be resolved." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:expires a owl:DatatypeProperty ;
    rdfs:label "expires" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date/time identifying when the finding information is no longer considered valid." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:export a owl:ObjectProperty ;
    rdfs:label "export" ;
    rdfs:range oscal:Export ;
    skos:definition "Defines a set of control implementations that are provided as reference implementations for use by organizations implementing the leveraged system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:expression a owl:DatatypeProperty ;
    rdfs:label "expression" ;
    rdfs:range xsd:string ;
    skos:definition "A formal (executable) expression of a constraint." ;
    skos:inScheme oscal:oscal_catalog .

oscal:filename a owl:DatatypeProperty ;
    rdfs:label "filename" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the file before it was encoded as Base64 to be embedded in a resource." ;
    skos:inScheme oscal:oscal_catalog .

oscal:finding_uuid a owl:DatatypeProperty ;
    rdfs:label "finding-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A UUID reference to a finding." ;
    skos:inScheme oscal:oscal_poam .

oscal:flat a owl:ObjectProperty ;
    rdfs:label "flat" ;
    rdfs:range oscal:MergeFlat ;
    skos:definition "Directs that controls appear without any grouping structure." ;
    skos:inScheme oscal:oscal_profile .

oscal:generation_method a owl:DatatypeProperty ;
    rdfs:label "generation-method" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:CoverageGenerationMethodEnum xsd:string ) ] ;
    skos:definition "Method used to determine the coverage value. Recommended values are in CoverageGenerationMethodEnum; other values are permitted." ;
    skos:inScheme oscal:oscal_mapping .

oscal:group a owl:DatatypeProperty ;
    rdfs:label "group" ;
    rdfs:range xsd:string ;
    skos:definition "An identifier for relating distinct sets of properties." ;
    skos:inScheme oscal:oscal_catalog .

oscal:how_many a owl:ObjectProperty ;
    rdfs:label "how-many" ;
    rdfs:range oscal:ParameterCardinalityEnum ;
    skos:altLabel "how_many" ;
    skos:definition "Describes the number of selections that must occur. Without this setting, only one value should be assumed to be permitted." ;
    skos:inScheme oscal:oscal_catalog .

oscal:id_ref a owl:DatatypeProperty ;
    rdfs:label "id-ref" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier reference of a source/target subject." ;
    skos:inScheme oscal:oscal_mapping .

oscal:identified_subject a owl:ObjectProperty ;
    rdfs:label "identified-subject" ;
    rdfs:range oscal:IdentifiedSubject ;
    skos:definition "Used to detail assessment subjects that were identified by this task." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:range xsd:string ;
    skos:definition "A document identifier value." ;
    skos:inScheme oscal:oscal_catalog .

oscal:identifier_type a owl:DatatypeProperty ;
    rdfs:label "identifier-type" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:SystemIdentifierTypeEnum xsd:anyURI ) ] ;
    skos:definition "A human-readable label for a specific identifier scheme. Recommended values are in SystemIdentifierTypeEnum; other URI values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:implementation_statement_uuid a owl:DatatypeProperty ;
    rdfs:label "implementation-statement-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A reference to the implementation statement in the SSP to which this finding is related." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:implementation_uuid a owl:DatatypeProperty ;
    rdfs:label "implementation-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A machine-oriented, globally unique identifier with cross-instance scope that can be used to reference this implementation statement elsewhere in this or other OSCAL instances." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:import_ap a owl:ObjectProperty ;
    rdfs:label "import-ap" ;
    rdfs:range oscal:ImportAssessmentPlan ;
    skos:definition "Used to import information about the governing assessment plan." ;
    skos:inScheme oscal:oscal_assessment_results .

oscal:import_profile a owl:ObjectProperty ;
    rdfs:label "import-profile" ;
    rdfs:range oscal:ImportProfile ;
    skos:definition "Used to import the OSCAL profile representing the system's control baseline." ;
    skos:inScheme oscal:oscal_ssp .

oscal:integrity_impact a owl:ObjectProperty ;
    rdfs:label "integrity-impact" ;
    rdfs:range oscal:ImpactLevel ;
    skos:definition "The expected level of impact resulting from the unauthorized modification of the described information." ;
    skos:inScheme oscal:oscal_ssp .

oscal:lifecycle a owl:DatatypeProperty ;
    rdfs:label "lifecycle" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:ResponseLifecycleEnum xsd:string ) ] ;
    skos:definition "Identifies whether this is a recommendation or an actual plan. Recommended values are in ResponseLifecycleEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:mapping_collection a owl:ObjectProperty ;
    rdfs:label "mapping-collection" ;
    rdfs:range oscal:MappingCollection ;
    skos:definition "The root mapping collection object." ;
    skos:inScheme oscal:oscal_mapping .

oscal:merge a owl:ObjectProperty ;
    rdfs:label "merge" ;
    rdfs:range oscal:ProfileMerge ;
    skos:definition "Structuring directives for how controls are organized after profile resolution." ;
    skos:inScheme oscal:oscal_profile .

oscal:modify a owl:ObjectProperty ;
    rdfs:label "modify" ;
    rdfs:range oscal:ProfileModify ;
    skos:definition "Set parameters or amend controls in resolution." ;
    skos:inScheme oscal:oscal_profile .

oscal:network_architecture a owl:ObjectProperty ;
    rdfs:label "network-architecture" ;
    rdfs:range oscal:NetworkArchitecture ;
    skos:definition "A description of the system's network architecture, optionally supplemented with diagrams that illustrate the network architecture." ;
    skos:inScheme oscal:oscal_ssp .

oscal:number a owl:DatatypeProperty ;
    rdfs:label "number" ;
    rdfs:range xsd:string ;
    skos:definition "A telephone number value." ;
    skos:inScheme oscal:oscal_catalog .

oscal:objective_id a owl:DatatypeProperty ;
    rdfs:label "objective-id" ;
    rdfs:range xsd:string ;
    skos:definition "Reference to a control objective by its identifier." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:observation_uuid a owl:DatatypeProperty ;
    rdfs:label "observation-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A machine-oriented identifier reference to an observation defined in the list of observations." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:on_date a owl:ObjectProperty ;
    rdfs:label "on-date" ;
    rdfs:range oscal:OnDateCondition ;
    skos:definition "The task is intended to occur on the specified date." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:order a owl:ObjectProperty ;
    rdfs:label "order" ;
    rdfs:range oscal:InsertOrderEnum ;
    skos:definition "A designation of how a selection of controls is to be ordered." ;
    skos:inScheme oscal:oscal_profile .

oscal:origin a owl:ObjectProperty ;
    rdfs:label "origin" ;
    rdfs:range oscal:Origin ;
    skos:definition "The source of the finding." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:part a owl:ObjectProperty ;
    rdfs:label "part" ;
    rdfs:range oscal:AssessmentPart ;
    skos:definition "An assessment part." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:pattern a owl:DatatypeProperty ;
    rdfs:label "pattern" ;
    rdfs:range xsd:string ;
    skos:definition "A glob expression matching the IDs of one or more controls to be selected." ;
    skos:inScheme oscal:oscal_catalog .

oscal:percentage a owl:DatatypeProperty ;
    rdfs:label "percentage" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:definition "A decimal percentage value in the range 0 to 1." ;
    skos:inScheme oscal:oscal_mapping .

oscal:period a owl:DatatypeProperty ;
    rdfs:label "period" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:positiveInteger [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
    skos:definition "The task must occur every period (in the given units)." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:plan_of_action_and_milestones a owl:ObjectProperty ;
    rdfs:label "plan-of-action-and-milestones" ;
    rdfs:range oscal:PlanOfActionAndMilestones ;
    skos:definition "The root plan of action and milestones object." ;
    skos:inScheme oscal:oscal_poam .

oscal:position a owl:ObjectProperty ;
    rdfs:label "position" ;
    rdfs:range oscal:AdditionPositionEnum ;
    skos:definition "Where to add new content relative to the targeted element." ;
    skos:inScheme oscal:oscal_profile .

oscal:postal_code a owl:DatatypeProperty ;
    rdfs:label "postal-code" ;
    rdfs:range xsd:string ;
    skos:definition "Postal or ZIP code for mailing address." ;
    skos:inScheme oscal:oscal_catalog .

oscal:predicate a owl:ObjectProperty ;
    rdfs:label "predicate" ;
    rdfs:range oscal:QualifierPredicateEnum ;
    skos:definition "Predicate describing qualifier semantics." ;
    skos:inScheme oscal:oscal_mapping .

oscal:profile a owl:ObjectProperty ;
    rdfs:label "profile" ;
    rdfs:range oscal:Profile ;
    skos:definition "The root profile object." ;
    skos:inScheme oscal:oscal_profile .

oscal:provenance a owl:ObjectProperty ;
    rdfs:label "provenance" ;
    rdfs:range oscal:MappingProvenance ;
    skos:definition "Global provenance and mapping method metadata." ;
    skos:inScheme oscal:oscal_mapping .

oscal:reason a owl:DatatypeProperty ;
    rdfs:label "reason" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:ObjectiveStatusReasonEnum xsd:string ) ] ;
    skos:definition "The reason the objective was given its status. Recommended values are in ObjectiveStatusReasonEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:related_controls a owl:ObjectProperty ;
    rdfs:label "related-controls" ;
    rdfs:range oscal:ReviewedControls ;
    skos:definition "A reference to reviewed controls for this activity or step." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:relationship a owl:DatatypeProperty ;
    rdfs:label "relationship" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:RelationshipEnum xsd:string ) ] ;
    skos:definition "Relationship type for a mapping entry. OSCAL namespace values are defined by RelationshipEnum." ;
    skos:inScheme oscal:oscal_mapping .

oscal:resource_fragment a owl:DatatypeProperty ;
    rdfs:label "resource-fragment" ;
    rdfs:range xsd:string ;
    skos:definition "In case where the href points to a back-matter/resource, this value will indicate the URI fragment to append to any rlink associated with the resource. This value MUST be URI encoded." ;
    skos:inScheme oscal:oscal_catalog .

oscal:response_uuid a owl:DatatypeProperty ;
    rdfs:label "response-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A machine-oriented identifier reference to a unique risk response." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:responsibility_uuid a owl:DatatypeProperty ;
    rdfs:label "responsibility-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "Machine-oriented identifier reference to a control implementation responsibility imposed by a leveraged system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:risk_log a owl:ObjectProperty ;
    rdfs:label "risk-log" ;
    rdfs:range oscal:RiskLog ;
    skos:definition "A log of all risk-related tasks taken." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:risk_uuid a owl:DatatypeProperty ;
    rdfs:label "risk-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A machine-oriented identifier reference to a risk defined in the list of risks." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:security_impact_level a owl:ObjectProperty ;
    rdfs:label "security-impact-level" ;
    rdfs:range oscal:SecurityImpactLevel ;
    skos:definition "The overall level of expected impact resulting from unauthorized disclosure, modification, or loss of access to information." ;
    skos:inScheme oscal:oscal_ssp .

oscal:security_objective_availability a owl:DatatypeProperty ;
    rdfs:label "security-objective-availability" ;
    rdfs:range xsd:string ;
    skos:definition "A target-level of availability for the system, based on the sensitivity of information within the system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:security_objective_confidentiality a owl:DatatypeProperty ;
    rdfs:label "security-objective-confidentiality" ;
    rdfs:range xsd:string ;
    skos:definition "A target-level of confidentiality for the system, based on the sensitivity of information within the system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:security_objective_integrity a owl:DatatypeProperty ;
    rdfs:label "security-objective-integrity" ;
    rdfs:range xsd:string ;
    skos:definition "A target-level of integrity for the system, based on the sensitivity of information within the system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:security_sensitivity_level a owl:DatatypeProperty ;
    rdfs:label "security-sensitivity-level" ;
    rdfs:range xsd:string ;
    skos:definition "The overall information system sensitivity categorization, such as defined by FIPS-199." ;
    skos:inScheme oscal:oscal_ssp .

oscal:selected a owl:DatatypeProperty ;
    rdfs:label "selected" ;
    rdfs:range xsd:string ;
    skos:definition "The selected (Confidentiality, Integrity, or Availability) security impact level." ;
    skos:inScheme oscal:oscal_ssp .

oscal:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Reference to an external catalog or profile resource." ;
    skos:inScheme oscal:oscal_component .

oscal:source_gap_summary a owl:ObjectProperty ;
    rdfs:label "source-gap-summary" ;
    rdfs:range oscal:GapSummary ;
    skos:definition "Summary of unmapped source controls." ;
    skos:inScheme oscal:oscal_mapping .

oscal:source_resource a owl:ObjectProperty ;
    rdfs:label "source-resource" ;
    rdfs:range oscal:MappingResourceReference ;
    skos:definition "Reference to the mapping source resource." ;
    skos:inScheme oscal:oscal_mapping .

oscal:statement a owl:DatatypeProperty ;
    rdfs:label "statement" ;
    rdfs:range xsd:string ;
    skos:definition "An assessor's summary of the risk, in narrative form." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:status_change a owl:DatatypeProperty ;
    rdfs:label "status-change" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:RiskStatusEnum xsd:string ) ] ;
    skos:definition "Identifies the risk change that prompted the log entry. Recommended values are in RiskStatusEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:subject a owl:ObjectProperty ;
    rdfs:label "subject" ;
    rdfs:range oscal:QualifierSubjectEnum ;
    skos:definition "Subject to which the qualifier applies." ;
    skos:inScheme oscal:oscal_mapping .

oscal:subject_placeholder_uuid a owl:DatatypeProperty ;
    rdfs:label "subject-placeholder-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A reference to an assessment subject placeholder defined in the assessment plan." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:system_characteristics a owl:ObjectProperty ;
    rdfs:label "system-characteristics" ;
    rdfs:range oscal:SystemCharacteristics ;
    skos:definition "Contains the characteristics of the system, such as its name, purpose, and security impact level." ;
    skos:inScheme oscal:oscal_ssp .

oscal:system_id a owl:ObjectProperty ;
    rdfs:label "system-id" ;
    rdfs:range oscal:SystemId ;
    skos:definition "A human-oriented, globally unique identifier for a system." ;
    skos:inScheme oscal:oscal_poam .

oscal:system_implementation a owl:ObjectProperty ;
    rdfs:label "system-implementation" ;
    rdfs:range oscal:SystemImplementation ;
    skos:definition "Provides information as to how the system is implemented." ;
    skos:inScheme oscal:oscal_ssp .

oscal:system_information a owl:ObjectProperty ;
    rdfs:label "system-information" ;
    rdfs:range oscal:SystemInformation ;
    skos:definition "Contains details about all information types that are stored, processed, or transmitted by the system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:system_name a owl:DatatypeProperty ;
    rdfs:label "system-name" ;
    rdfs:range xsd:string ;
    skos:definition "The full name of the system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:system_name_short a owl:DatatypeProperty ;
    rdfs:label "system-name-short" ;
    rdfs:range xsd:string ;
    skos:definition "A short name for the system, such as an acronym, that is suitable for display in a data table or summary list." ;
    skos:inScheme oscal:oscal_ssp .

oscal:system_security_plan a owl:ObjectProperty ;
    rdfs:label "system-security-plan" ;
    rdfs:range oscal:SystemSecurityPlan ;
    skos:definition "A system security plan, such as those described in NIST SP 800-18." ;
    skos:inScheme oscal:oscal_ssp .

oscal:system_status a owl:ObjectProperty ;
    rdfs:label "system-status" ;
    rdfs:range oscal:SystemStatus ;
    skos:definition "Describes the operational status of the system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:target a owl:ObjectProperty ;
    rdfs:label "target" ;
    rdfs:range oscal:FindingTarget ;
    skos:definition "Identifies the target of a finding." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:target_coverage a owl:DatatypeProperty ;
    rdfs:label "target-coverage" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:definition "Percentage coverage of targets by sources." ;
    skos:inScheme oscal:oscal_mapping .

oscal:target_gap_summary a owl:ObjectProperty ;
    rdfs:label "target-gap-summary" ;
    rdfs:range oscal:GapSummary ;
    skos:definition "Summary of unmapped target controls." ;
    skos:inScheme oscal:oscal_mapping .

oscal:target_id a owl:DatatypeProperty ;
    rdfs:label "target-id" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the specific target qualified by the type." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:target_resource a owl:ObjectProperty ;
    rdfs:label "target-resource" ;
    rdfs:range oscal:MappingResourceReference ;
    skos:definition "Reference to the mapping target resource." ;
    skos:inScheme oscal:oscal_mapping .

oscal:terms_and_conditions a owl:ObjectProperty ;
    rdfs:label "terms-and-conditions" ;
    rdfs:range oscal:TermsAndConditions ;
    skos:definition "Terms and conditions under which an assessment can be performed." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:timing a owl:ObjectProperty ;
    rdfs:label "timing" ;
    rdfs:range oscal:EventTiming ;
    skos:definition "The timing under which a task is intended to occur." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:transport a owl:ObjectProperty ;
    rdfs:label "transport" ;
    rdfs:range oscal:TransportEnum ;
    skos:definition "Indicates the transport type." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:unit a owl:ObjectProperty ;
    rdfs:label "unit" ;
    rdfs:range oscal:TimingUnitEnum ;
    skos:definition "The unit of time for the period." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:with_child_controls a owl:ObjectProperty ;
    rdfs:label "with-child-controls" ;
    rdfs:range oscal:WithChildControlsEnum ;
    skos:definition "When a control is included, whether its child (dependent) controls are also included." ;
    skos:inScheme oscal:oscal_catalog .

oscal:within_date_range a owl:ObjectProperty ;
    rdfs:label "within-date-range" ;
    rdfs:range oscal:WithinDateRange ;
    skos:definition "The task is intended to occur within the specified date range." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:country ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:country ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:city ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:state ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:AddressTypeEnum xsd:string ) ] xsd:string ) ] ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:state ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:addr_lines ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:addr_lines ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:state ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:country ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:city ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:city ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:postal_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:postal_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:postal_code ] ;
    skos:definition "A postal address for the location." ;
    skos:inScheme oscal:oscal_catalog .

oscal:AlterationPropNameEnum a owl:Class ;
    rdfs:label "AlterationPropNameEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/AlterationPropNameEnum#label> <https://w3id.org/lmodel/oscal/AlterationPropNameEnum#sort-id> <https://w3id.org/lmodel/oscal/AlterationPropNameEnum#alt-identifier> ) ;
    skos:definition "Allowed OSCAL property names for profile modification additions." ;
    skos:inScheme oscal:oscal_profile ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/AlterationPropNameEnum#alt-identifier>,
        <https://w3id.org/lmodel/oscal/AlterationPropNameEnum#label>,
        <https://w3id.org/lmodel/oscal/AlterationPropNameEnum#sort-id> ;
    oscal:oscal_allowed_values "oscal-part-prop-name" .

oscal:AssessmentAssets a owl:Class ;
    rdfs:label "AssessmentAssets" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:components ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:assessment_platforms ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:SystemComponent ;
            owl:onProperty oscal:components ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:AssessmentPlatform ;
            owl:onProperty oscal:assessment_platforms ] ;
    skos:definition "Identifies the assets used to perform this assessment." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:AssessmentPartNameEnum a owl:Class ;
    rdfs:label "AssessmentPartNameEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/AssessmentPartNameEnum#asset> <https://w3id.org/lmodel/oscal/AssessmentPartNameEnum#method> <https://w3id.org/lmodel/oscal/AssessmentPartNameEnum#objective> ) ;
    skos:definition """Curated assessment part name values. Other values are permitted (OSCAL allow-other="yes").
""" ;
    skos:inScheme oscal:oscal_assessment_plan ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/AssessmentPartNameEnum#asset>,
        <https://w3id.org/lmodel/oscal/AssessmentPartNameEnum#method>,
        <https://w3id.org/lmodel/oscal/AssessmentPartNameEnum#objective> ;
    oscal:allow_any true ;
    oscal:oscal_allowed_values "oscal-assessment-part-values" .

oscal:AssuranceLevelValueEnum a owl:Class ;
    rdfs:label "AssuranceLevelValueEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/AssuranceLevelValueEnum#1> <https://w3id.org/lmodel/oscal/AssuranceLevelValueEnum#2> <https://w3id.org/lmodel/oscal/AssuranceLevelValueEnum#3> ) ;
    skos:definition "NIST SP 800-63 assurance level values." ;
    skos:inScheme oscal:oscal_ssp ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/AssuranceLevelValueEnum#1>,
        <https://w3id.org/lmodel/oscal/AssuranceLevelValueEnum#2>,
        <https://w3id.org/lmodel/oscal/AssuranceLevelValueEnum#3> ;
    oscal:oscal_allowed_values "oscal-system-characteristics-prop-sp-800-63-assurance-level-values" .

oscal:CombinationMethodEnum a owl:Class ;
    rdfs:label "CombinationMethodEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/CombinationMethodEnum#use-first> <https://w3id.org/lmodel/oscal/CombinationMethodEnum#merge> <https://w3id.org/lmodel/oscal/CombinationMethodEnum#keep> ) ;
    skos:definition "Methods for resolving duplicate control instances during merge." ;
    skos:inScheme oscal:oscal_profile ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/CombinationMethodEnum#keep>,
        <https://w3id.org/lmodel/oscal/CombinationMethodEnum#merge>,
        <https://w3id.org/lmodel/oscal/CombinationMethodEnum#use-first> ;
    oscal:oscal_allowed_values "oscal-profile-merge-combine-method-values" .

oscal:ConfidenceScore a owl:Class ;
    rdfs:label "ConfidenceScore" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty oscal:percentage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:ConfidenceCategoryEnum xsd:string ) ] xsd:string ) ] ;
            owl:onProperty oscal:category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:percentage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:percentage ] ;
    skos:definition "Confidence represented as a category and/or percentage value." ;
    skos:inScheme oscal:oscal_mapping .

oscal:Control a owl:Class ;
    rdfs:label "Control" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oscal:Part ;
            owl:onProperty oscal:parts ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:_class ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Control ;
            owl:onProperty oscal:controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:_class ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:controls ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:parts ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:_class ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:params ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Parameter ;
            owl:onProperty oscal:params ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:id ],
        oscal:HasPropsAndLinks ;
    skos:definition "A structured object representing a requirement or guideline, which when implemented will reduce an aspect of risk related to an information system and its information." ;
    skos:inScheme oscal:oscal_catalog .

oscal:ControlPropNameEnum a owl:Class ;
    rdfs:label "ControlPropNameEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/ControlPropNameEnum#label> <https://w3id.org/lmodel/oscal/ControlPropNameEnum#sort-id> <https://w3id.org/lmodel/oscal/ControlPropNameEnum#alt-identifier> <https://w3id.org/lmodel/oscal/ControlPropNameEnum#status> ) ;
    skos:definition "Allowed OSCAL property names for catalog controls." ;
    skos:inScheme oscal:oscal_catalog ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/ControlPropNameEnum#alt-identifier>,
        <https://w3id.org/lmodel/oscal/ControlPropNameEnum#label>,
        <https://w3id.org/lmodel/oscal/ControlPropNameEnum#sort-id>,
        <https://w3id.org/lmodel/oscal/ControlPropNameEnum#status> ;
    oscal:oscal_allowed_values "oscal-control-prop-name" .

oscal:Coverage a owl:Class ;
    rdfs:label "Coverage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( oscal:CoverageGenerationMethodEnum xsd:string ) ] ;
            owl:onProperty oscal:generation_method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:target_coverage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:target_coverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty oscal:target_coverage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:generation_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:generation_method ] ;
    skos:definition "A percentage representing target coverage by source mappings." ;
    skos:inScheme oscal:oscal_mapping .

oscal:Diagram a owl:Class ;
    rdfs:label "Diagram" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:SspDiagramLink ;
            owl:onProperty oscal:links ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:caption ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:links ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:caption ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:props ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Property ;
            owl:onProperty oscal:props ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:caption ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:remarks ] ;
    skos:definition "A graphic that provides a visual representation the system, or some aspect of it." ;
    skos:inScheme oscal:oscal_ssp .

oscal:GapSummary a owl:Class ;
    rdfs:label "GapSummary" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:SelectControlById ;
            owl:onProperty oscal:unmapped_controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:unmapped_controls ] ;
    skos:definition "A summary of controls that were not mapped." ;
    skos:inScheme oscal:oscal_mapping .

oscal:ImplementationCommonLink a owl:Class ;
    rdfs:label "ImplementationCommonLink" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( oscal:ImplementationLinkRelEnum xsd:string ) ] ;
            owl:onProperty oscal:rel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:rel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:rel ],
        oscal:Link ;
    skos:definition "Implementation-common scoped OSCAL link." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:ImplementationCommonProperty a owl:Class ;
    rdfs:label "ImplementationCommonProperty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( oscal:ImplementationYesNoEnum oscal:ImplementationAssetTypeEnum oscal:ImplementationPointEnum oscal:ImplementationIpAddressClassEnum oscal:ImplementationDirectionEnum oscal:UserTypeEnum oscal:UserPrivilegeLevelEnum xsd:string ) ] ;
            owl:onProperty oscal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ImplementationPropNameEnum ;
            owl:onProperty oscal:name ],
        oscal:Property ;
    skos:definition "Implementation-common scoped OSCAL property." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:InterconnectionResponsibleRoleIdEnum a owl:Class ;
    rdfs:label "InterconnectionResponsibleRoleIdEnum" ;
