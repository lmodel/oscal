        <https://w3id.org/lmodel/oscal/SystemIdentifierTypeEnum#https%3A%2F%2Fietf.org%2Frfc%2Frfc4122> ;
    oscal:allow_any true ;
    oscal:oscal_allowed_values "oscal-system-identifier-type-values" .

oscal:ByItemNameEnum a owl:Class ;
    rdfs:label "ByItemNameEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/ByItemNameEnum#param> <https://w3id.org/lmodel/oscal/ByItemNameEnum#prop> <https://w3id.org/lmodel/oscal/ByItemNameEnum#link> <https://w3id.org/lmodel/oscal/ByItemNameEnum#part> <https://w3id.org/lmodel/oscal/ByItemNameEnum#mapping> <https://w3id.org/lmodel/oscal/ByItemNameEnum#map> ) ;
    skos:definition "Identifies content to remove by the item's object type name." ;
