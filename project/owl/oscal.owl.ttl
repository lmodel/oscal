oscal:SystemComponent a owl:Class ;
    rdfs:label "SystemComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:protocols ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:purpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:props ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:ComponentTypeEnum xsd:string ) ] xsd:string ) ] ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ImplementationResponsibleRole ;
            owl:onProperty oscal:responsible_roles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ComponentStatus ;
            owl:onProperty oscal:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ImplementationCommonLink ;
            owl:onProperty oscal:links ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ImplementationCommonProperty ;
            owl:onProperty oscal:props ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:links ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Protocol ;
            owl:onProperty oscal:protocols ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:responsible_roles ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:title ],
        oscal:HasResponsibleRoles,
        oscal:OscalCommon ;
    skos:definition "A defined component that can be part of an implemented system." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:SystemOperatingStatusEnum a owl:Class ;
    rdfs:label "SystemOperatingStatusEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#operational> <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#under-development> <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#under-major-modification> <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#disposition> <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#other> ) ;
    skos:definition "Allowable operational states for an OSCAL-described system." ;
    skos:inScheme oscal:oscal_ssp ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#disposition>,
        <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#operational>,
        <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#other>,
        <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#under-development>,
        <https://w3id.org/lmodel/oscal/SystemOperatingStatusEnum#under-major-modification> ;
    oscal:oscal_allowed_values "oscal-status-state-values" .

oscal:by_id a owl:DatatypeProperty ;
    rdfs:label "by-id" ;
    rdfs:range xsd:string ;
    skos:definition "Identify or target items by their id value." ;
    skos:inScheme oscal:oscal_profile .

oscal:category a owl:DatatypeProperty ;
    rdfs:label "category" ;
    rdfs:range xsd:string ;
    skos:definition "Confidence category label or qualifier category value." ;
    skos:inScheme oscal:oscal_mapping .

oscal:controls a owl:ObjectProperty ;
    rdfs:label "controls" ;
    rdfs:range oscal:Control ;
    skos:definition "A collection of controls." ;
    skos:inScheme oscal:oscal_catalog .

oscal:date a owl:DatatypeProperty ;
    rdfs:label "date" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time when the action occurred." ;
    skos:inScheme oscal:oscal_catalog .

oscal:date_authorized a owl:DatatypeProperty ;
    rdfs:label "date-authorized" ;
    rdfs:range xsd:string ;
    skos:definition "The date the system received its authorization." ;
    skos:inScheme oscal:oscal_ssp .

oscal:depends_on a owl:DatatypeProperty ;
    rdfs:label "depends-on" ;
    rdfs:range xsd:string ;
    skos:definition "(deprecated) Another parameter invoking this one. This construct has been deprecated and should not be used." ;
    skos:inScheme oscal:oscal_catalog .

oscal:diagrams a owl:ObjectProperty ;
    rdfs:label "diagrams" ;
    rdfs:range oscal:Diagram ;
    skos:definition "A collection of diagrams that visually depict the subject." ;
    skos:inScheme oscal:oscal_ssp .

oscal:exclude_controls a owl:DatatypeProperty ;
    rdfs:label "exclude-controls" ;
    skos:definition "Control-selection entries to exclude in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
    skos:inScheme oscal:oscal_catalog .

oscal:implementation_status a owl:ObjectProperty ;
    rdfs:label "implementation-status" ;
    rdfs:range oscal:ImplementationStatus ;
    skos:definition "Identifies the implementation status of the control." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:import_ssp a owl:ObjectProperty ;
    rdfs:label "import-ssp" ;
    rdfs:range oscal:ImportSSP ;
    skos:definition "Used to import information about the system from an SSP." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:include_controls a owl:DatatypeProperty ;
    rdfs:label "include-controls" ;
    skos:definition "Control-selection entries to include in the containing OSCAL context. The concrete entry class is selected by class-level slot_usage." ;
    skos:inScheme oscal:oscal_catalog .

oscal:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    rdfs:range xsd:string ;
    skos:definition "A short, placeholder name for the parameter, which can be used as a substitute for a value if no value is assigned." ;
    skos:inScheme oscal:oscal_catalog .

oscal:last_modified a owl:DatatypeProperty ;
    rdfs:label "last-modified" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time the document was last modified." ;
    skos:inScheme oscal:oscal_catalog .

oscal:mapping_description a owl:DatatypeProperty ;
    rdfs:label "mapping-description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the context and intended use of the mapping." ;
    skos:inScheme oscal:oscal_mapping .

oscal:oscal_version a owl:DatatypeProperty ;
    rdfs:label "oscal-version" ;
    rdfs:range xsd:string ;
    skos:definition "The OSCAL model version the document was authored against and will conform to as valid." ;
    skos:inScheme oscal:oscal_catalog .

oscal:param_id a owl:DatatypeProperty ;
    rdfs:label "param-id" ;
    rdfs:range xsd:string ;
    skos:definition "The identifier for the parameter being set or referenced." ;
    skos:inScheme oscal:oscal_catalog .

oscal:party_uuid a owl:DatatypeProperty ;
    rdfs:label "party-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A machine-oriented identifier reference to the party who is making the log entry." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:provided_uuid a owl:DatatypeProperty ;
    rdfs:label "provided-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "Machine-oriented identifier reference to an inherited control implementation that a leveraging system is implementing." ;
    skos:inScheme oscal:oscal_ssp .

oscal:published a owl:DatatypeProperty ;
    rdfs:label "published" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time the document was last made available." ;
    skos:inScheme oscal:oscal_catalog .

oscal:purpose a owl:DatatypeProperty ;
    rdfs:label "purpose" ;
    rdfs:range xsd:string ;
    skos:definition "A summary of the technological or business purpose of the component." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:related_observations a owl:ObjectProperty ;
    rdfs:label "related-observations" ;
    rdfs:range oscal:RelatedObservation ;
    skos:definition "Relates the containing object to a set of referenced observations." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:related_tasks a owl:ObjectProperty ;
    rdfs:label "related-tasks" ;
    rdfs:range oscal:RelatedTask ;
    skos:definition "Identifies tasks for which the containing object is a consequence." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:scheme a owl:DatatypeProperty ;
    rdfs:label "scheme" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Qualifies the kind of identifier using a URI." ;
    skos:inScheme oscal:oscal_catalog .

oscal:statement_id a owl:DatatypeProperty ;
    rdfs:label "statement-id" ;
    rdfs:range xsd:string ;
    skos:definition "A reference to a control statement identifier." ;
    skos:inScheme oscal:oscal_catalog .

oscal:subject_uuid a owl:DatatypeProperty ;
    rdfs:label "subject-uuid" ;
    rdfs:range xsd:string ;
    skos:definition "A UUID reference to the identified subject." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:range xsd:string ;
    skos:definition "A textual label to associate with the containing object." ;
    skos:inScheme oscal:oscal_catalog .

oscal:usage a owl:DatatypeProperty ;
    rdfs:label "usage" ;
    rdfs:range xsd:string ;
    skos:definition "Describes the purpose and use of a parameter." ;
    skos:inScheme oscal:oscal_catalog .

oscal:users a owl:ObjectProperty ;
    rdfs:label "users" ;
    rdfs:range oscal:SystemUser ;
    skos:definition "A collection of system users." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:range xsd:string ;
    skos:definition "Used to distinguish a specific revision of an OSCAL document from other previous and future versions." ;
    skos:inScheme oscal:oscal_catalog .

oscal:CloudDeploymentModelEnum a owl:Class ;
    rdfs:label "CloudDeploymentModelEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#public-cloud> <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#private-cloud> <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#community-cloud> <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#hybrid-cloud> <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#government-only-cloud> <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#other> ) ;
    skos:definition "Cloud deployment model values used by OSCAL SSP properties." ;
    skos:inScheme oscal:oscal_ssp ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#community-cloud>,
        <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#government-only-cloud>,
        <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#hybrid-cloud>,
        <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#other>,
        <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#private-cloud>,
        <https://w3id.org/lmodel/oscal/CloudDeploymentModelEnum#public-cloud> ;
    oscal:oscal_allowed_values "oscal-system-characteristics-prop-cloud-deployment-model-values" .

oscal:ControlPropStatusValueEnum a owl:Class ;
    rdfs:label "ControlPropStatusValueEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#withdrawn> <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#reserved> <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#deprecated> <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#conditional> <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#superseded> <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#modified> <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#experimental> ) ;
    skos:definition "Curated OSCAL status property values for catalog controls. Other values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_catalog ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#conditional>,
        <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#deprecated>,
        <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#experimental>,
        <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#modified>,
        <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#reserved>,
        <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#superseded>,
        <https://w3id.org/lmodel/oscal/ControlPropStatusValueEnum#withdrawn> ;
    oscal:allow_any true ;
    oscal:oscal_allowed_values "oscal-control-prop-status-value" .

oscal:MappingStatusEnum a owl:Class ;
    rdfs:label "MappingStatusEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/MappingStatusEnum#complete> <https://w3id.org/lmodel/oscal/MappingStatusEnum#not-complete> <https://w3id.org/lmodel/oscal/MappingStatusEnum#draft> <https://w3id.org/lmodel/oscal/MappingStatusEnum#deprecated> <https://w3id.org/lmodel/oscal/MappingStatusEnum#superseded> ) ;
