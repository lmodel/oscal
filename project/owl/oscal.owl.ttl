oscal:DefinedComponent a owl:Class ;
    rdfs:label "DefinedComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oscal:ControlImplementationSet ;
            owl:onProperty oscal:control_implementations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
