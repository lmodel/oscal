@prefix linkml: <https://w3id.org/linkml/> .
@prefix oscal: <https://w3id.org/lmodel/oscal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
