oscal:MappingResourceReference a owl:Class ;
    rdfs:label "MappingResourceReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:ns ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty oscal:ns ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:MappingResourceTypeEnum xsd:string ) ] xsd:string ) ] ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:ns ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:type ],
        oscal:OscalCommon ;
    skos:definition "A reference to the source or target resource for a mapping." ;
    skos:inScheme oscal:oscal_mapping .

