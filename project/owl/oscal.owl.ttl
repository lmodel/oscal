oscal:HasResponsibleParties a owl:Class ;
    rdfs:label "HasResponsibleParties" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oscal:ResponsibleParty ;
            owl:onProperty oscal:responsible_parties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:responsible_parties ] ;
    skos:definition "Mixin providing the responsible-parties slot for objects that carry party assignments." ;
    skos:inScheme oscal:oscal_catalog .

oscal:HasResponsibleRoles a owl:Class ;
    rdfs:label "HasResponsibleRoles" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oscal:ResponsibleRole ;
            owl:onProperty oscal:responsible_roles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:responsible_roles ] ;
    skos:definition "Mixin providing the responsible-roles slot for objects that carry role assignments." ;
    skos:inScheme oscal:oscal_catalog .

