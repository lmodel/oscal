            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Protocol ;
            owl:onProperty oscal:protocols ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:purpose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:control_implementations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:protocols ],
        oscal:HasResponsibleRoles,
        oscal:OscalCommon ;
    skos:definition "A defined component that can be part of an implemented system." ;
    skos:inScheme oscal:oscal_component .

