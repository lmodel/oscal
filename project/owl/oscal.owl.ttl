oscal:OscalResponsePropTypeValueEnum a owl:Class ;
    rdfs:label "OscalResponsePropTypeValueEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#avoid> <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#mitigate> <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#transfer> <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#accept> <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#share> <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#contingency> <https://w3id.org/lmodel/oscal/OscalResponsePropTypeValueEnum#none> ) ;
    skos:definition "Values from assessment-common set oscal-response-prop-type-value." ;
