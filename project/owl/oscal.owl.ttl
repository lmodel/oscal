oscal:AssessmentPart a owl:Class ;
    rdfs:label "AssessmentPart" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( oscal:AssessmentPartNameEnum xsd:string ) ] xsd:string ) ] ;
            owl:onProperty oscal:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:ns ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:prose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty oscal:ns ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:ns ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:prose ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:AssessmentPart ;
            owl:onProperty oscal:parts ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:_class ],
        [ a owl:Restriction ;
