oscal:ImplementationResponsibleParty a owl:Class ;
    rdfs:label "ImplementationResponsibleParty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:role_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:role_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( oscal:ImplementationResponsibleRoleIdEnum xsd:string ) ] ;
            owl:onProperty oscal:role_id ],
        oscal:ResponsibleParty ;
    skos:definition "Implementation-common scoped responsible party." ;
    skos:inScheme oscal:oscal_assessment_plan .

