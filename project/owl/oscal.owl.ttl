    skos:definition "Curated interconnection responsible-role identifiers. Other values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_assessment_plan ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/InterconnectionResponsibleRoleIdEnum#isa-authorizing-official-local>,
        <https://w3id.org/lmodel/oscal/InterconnectionResponsibleRoleIdEnum#isa-authorizing-official-remote>,
        <https://w3id.org/lmodel/oscal/InterconnectionResponsibleRoleIdEnum#isa-poc-local>,
        <https://w3id.org/lmodel/oscal/InterconnectionResponsibleRoleIdEnum#isa-poc-remote> ;
    oscal:allow_any true ;
