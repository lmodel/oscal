oscal:PortRange a owl:Class ;
    rdfs:label "PortRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:nonNegativeInteger [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty oscal:start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:transport ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:TransportEnum ;
            owl:onProperty oscal:transport ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:start ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:nonNegativeInteger [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty oscal:end ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:start ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:transport ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:end ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:end ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:remarks ] ;
    skos:definition "Where applicable, the transport layer protocol port range." ;
    skos:inScheme oscal:oscal_assessment_plan .

