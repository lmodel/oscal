        <https://w3id.org/lmodel/oscal/MappingStatusEnum#superseded> ;
    oscal:oscal_allowed_values "oscal_mapping-common_metaschema.xml#status#." .

oscal:MatchingRationaleEnum a owl:Class ;
    rdfs:label "MatchingRationaleEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/MatchingRationaleEnum#syntactic> <https://w3id.org/lmodel/oscal/MatchingRationaleEnum#semantic> <https://w3id.org/lmodel/oscal/MatchingRationaleEnum#functional> ) ;
