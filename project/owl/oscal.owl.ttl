    rdfs:subClassOf oscal:TimingUnitEnum .

<https://w3id.org/lmodel/oscal/TimingUnitEnum#minutes> a owl:Class ;
    rdfs:label "minutes" ;
    rdfs:subClassOf oscal:TimingUnitEnum .

<https://w3id.org/lmodel/oscal/TimingUnitEnum#months> a owl:Class ;
    rdfs:label "months" ;
    rdfs:subClassOf oscal:TimingUnitEnum .

<https://w3id.org/lmodel/oscal/TimingUnitEnum#seconds> a owl:Class ;
    rdfs:label "seconds" ;
    rdfs:subClassOf oscal:TimingUnitEnum .

<https://w3id.org/lmodel/oscal/TimingUnitEnum#years> a owl:Class ;
    rdfs:label "years" ;
    rdfs:subClassOf oscal:TimingUnitEnum .

<https://w3id.org/lmodel/oscal/TransportEnum#TCP> a owl:Class ;
    rdfs:label "TCP" ;
    rdfs:subClassOf oscal:TransportEnum .

<https://w3id.org/lmodel/oscal/TransportEnum#UDP> a owl:Class ;
    rdfs:label "UDP" ;
    rdfs:subClassOf oscal:TransportEnum .

<https://w3id.org/lmodel/oscal/UserPrivilegeLevelEnum#no-logical-access> a owl:Class ;
    rdfs:label "no-logical-access" ;
    rdfs:subClassOf oscal:UserPrivilegeLevelEnum .

<https://w3id.org/lmodel/oscal/UserPrivilegeLevelEnum#non-privileged> a owl:Class ;
    rdfs:label "non-privileged" ;
    rdfs:subClassOf oscal:UserPrivilegeLevelEnum .

<https://w3id.org/lmodel/oscal/UserPrivilegeLevelEnum#privileged> a owl:Class ;
    rdfs:label "privileged" ;
    rdfs:subClassOf oscal:UserPrivilegeLevelEnum .

<https://w3id.org/lmodel/oscal/UserTypeEnum#external> a owl:Class ;
    rdfs:label "external" ;
    rdfs:subClassOf oscal:UserTypeEnum .

<https://w3id.org/lmodel/oscal/UserTypeEnum#general-public> a owl:Class ;
    rdfs:label "general-public" ;
    rdfs:subClassOf oscal:UserTypeEnum .

<https://w3id.org/lmodel/oscal/UserTypeEnum#internal> a owl:Class ;
    rdfs:label "internal" ;
    rdfs:subClassOf oscal:UserTypeEnum .

oscal:UsesComponent a owl:Class ;
    rdfs:label "UsesComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:component_uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:component_uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:component_uuid ],
        oscal:HasResponsibleParties,
        oscal:OscalCommon ;
    skos:definition "The set of components that are used by the assessment platform." ;
    skos:inScheme oscal:oscal_assessment_plan .

<https://w3id.org/lmodel/oscal/WithChildControlsEnum#no> a owl:Class ;
    rdfs:label "no" ;
    rdfs:subClassOf oscal:WithChildControlsEnum .

<https://w3id.org/lmodel/oscal/WithChildControlsEnum#yes> a owl:Class ;
    rdfs:label "yes" ;
    rdfs:subClassOf oscal:WithChildControlsEnum .

oscal:WithinDateRange a owl:Class ;
    rdfs:label "WithinDateRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:remarks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty oscal:end ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:end ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:start ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:start ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty oscal:start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:remarks ] ;
    skos:definition "The task is intended to occur within the specified date range." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:actions a owl:ObjectProperty ;
    rdfs:label "actions" ;
    rdfs:range oscal:Action ;
    skos:definition "An action applied by a role within a given party to the content." ;
    skos:inScheme oscal:oscal_catalog .

oscal:actors a owl:ObjectProperty ;
    rdfs:label "actors" ;
    rdfs:range oscal:OriginActor ;
    skos:definition "The actor that produces an observation, a finding, or a risk." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:addr_lines a owl:DatatypeProperty ;
    rdfs:label "addr-lines" ;
    rdfs:range xsd:string ;
    skos:definition "A single line of an address." ;
    skos:inScheme oscal:oscal_catalog .

oscal:adds a owl:ObjectProperty ;
    rdfs:label "adds" ;
    rdfs:range oscal:Addition ;
    skos:definition "Specifies content to be added into a control in resolution." ;
    skos:inScheme oscal:oscal_profile .

oscal:alters a owl:ObjectProperty ;
    rdfs:label "alters" ;
    rdfs:range oscal:Alteration ;
    skos:definition "Specifies changes to be made to included controls in resolution." ;
    skos:inScheme oscal:oscal_profile .

oscal:assessment_platforms a owl:ObjectProperty ;
    rdfs:label "assessment-platforms" ;
    rdfs:range oscal:AssessmentPlatform ;
    skos:definition "A collection of assessment platforms." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:assessment_subjects a owl:ObjectProperty ;
    rdfs:label "assessment-subjects" ;
    rdfs:range oscal:AssessmentSubject ;
    skos:definition "Identifies system elements being assessed." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:associated_activities a owl:ObjectProperty ;
    rdfs:label "associated-activities" ;
    rdfs:range oscal:AssociatedActivity ;
    skos:definition "Activities associated with this task." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:attestations a owl:ObjectProperty ;
    rdfs:label "attestations" ;
    rdfs:range oscal:Attestation ;
    skos:definition "A set of attestation statements for the result." ;
    skos:inScheme oscal:oscal_assessment_results .

oscal:authorized_privileges a owl:ObjectProperty ;
    rdfs:label "authorized-privileges" ;
    rdfs:range oscal:AuthorizedPrivilege ;
    skos:definition "A collection of authorized privileges." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:capabilities a owl:ObjectProperty ;
    rdfs:label "capabilities" ;
    rdfs:range oscal:Capability ;
    skos:definition "Capability groupings for the defined components." ;
    skos:inScheme oscal:oscal_component .

oscal:categorizations a owl:ObjectProperty ;
    rdfs:label "categorizations" ;
    rdfs:range oscal:InformationTypeCategorization ;
    skos:definition "A set of information type identifiers qualified by the given identification system used." ;
    skos:inScheme oscal:oscal_ssp .

oscal:characterizations a owl:ObjectProperty ;
    rdfs:label "characterizations" ;
    rdfs:range oscal:Characterization ;
    skos:definition "Supporting information about the risk and how it relates to the system." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:choice a owl:DatatypeProperty ;
    rdfs:label "choice" ;
    rdfs:range xsd:string ;
    skos:definition "A value selection among several such options." ;
    skos:inScheme oscal:oscal_catalog .

oscal:control_objective_selections a owl:ObjectProperty ;
    rdfs:label "control-objective-selections" ;
    rdfs:range oscal:ControlObjectiveSelection ;
    skos:definition "Identifies the control objectives of the assessment." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:control_selections a owl:ObjectProperty ;
    rdfs:label "control-selections" ;
    rdfs:range oscal:ControlSelection ;
    skos:definition "Identifies the controls being assessed." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:dependencies a owl:ObjectProperty ;
    rdfs:label "dependencies" ;
    rdfs:range oscal:TaskDependency ;
    skos:definition "Tasks that this task depends on." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:exclude_objectives a owl:ObjectProperty ;
    rdfs:label "exclude-objectives" ;
    rdfs:range oscal:SelectObjectiveById ;
    skos:definition "Objectives to exclude from the assessment." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:exclude_subjects a owl:ObjectProperty ;
    rdfs:label "exclude-subjects" ;
    rdfs:range oscal:SelectSubjectById ;
    skos:definition "Assessment subjects to exclude." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:external_ids a owl:ObjectProperty ;
    rdfs:label "external-ids" ;
    rdfs:range oscal:PartyExternalId ;
    skos:definition "An identifier for a person or organization using a designated scheme, e.g. an Open Researcher and Contributor ID (ORCID)." ;
    skos:inScheme oscal:oscal_catalog .

oscal:facets a owl:ObjectProperty ;
    rdfs:label "facets" ;
    rdfs:range oscal:Facet ;
    skos:definition "An individual characteristic that is part of a larger set produced by the same actor." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:functions_performed a owl:DatatypeProperty ;
    rdfs:label "functions-performed" ;
    rdfs:range xsd:string ;
    skos:definition "Describes a function performed for a given authorized privilege." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:hashes a owl:ObjectProperty ;
    rdfs:label "hashes" ;
    rdfs:range oscal:Hash ;
    skos:definition "A representation of a cryptographic digest generated over a resource using a specified hash algorithm." ;
    skos:inScheme oscal:oscal_catalog .

oscal:implemented_components a owl:ObjectProperty ;
    rdfs:label "implemented-components" ;
    rdfs:range oscal:ImplementedComponent ;
    skos:definition "A collection of implemented components." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:import_component_definitions a owl:ObjectProperty ;
    rdfs:label "import-component-definitions" ;
    rdfs:range oscal:ImportComponentDefinition ;
    skos:definition "Component-definition resources imported into this document." ;
    skos:inScheme oscal:oscal_component .

oscal:imports a owl:ObjectProperty ;
    rdfs:label "imports" ;
    rdfs:range oscal:ProfileImport ;
    skos:definition "Designates source catalog or profile resources to be imported into the profile." ;
    skos:inScheme oscal:oscal_profile .

oscal:include_objectives a owl:ObjectProperty ;
    rdfs:label "include-objectives" ;
    rdfs:range oscal:SelectObjectiveById ;
    skos:definition "Objectives to include in the assessment." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:include_subjects a owl:ObjectProperty ;
    rdfs:label "include-subjects" ;
    rdfs:range oscal:SelectSubjectById ;
    skos:definition "Assessment subjects to include." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:incorporates_components a owl:ObjectProperty ;
    rdfs:label "incorporates-components" ;
    rdfs:range oscal:IncorporatesComponent ;
    skos:definition "Component references incorporated by a capability." ;
    skos:inScheme oscal:oscal_component .

oscal:information_type_ids a owl:DatatypeProperty ;
    rdfs:label "information-type-ids" ;
    rdfs:range xsd:string ;
    skos:definition "An identifier qualified by the given identification system used, such as NIST SP 800-60." ;
    skos:inScheme oscal:oscal_ssp .

oscal:information_types a owl:ObjectProperty ;
    rdfs:label "information-types" ;
    rdfs:range oscal:InformationType ;
    skos:definition "Contains details about one information type that is stored, processed, or transmitted by the system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:inherited a owl:ObjectProperty ;
    rdfs:label "inherited" ;
    rdfs:range oscal:InheritedControlImplementation ;
    skos:definition "Describes a control implementation inherited by a leveraging system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:leveraged_authorizations a owl:ObjectProperty ;
    rdfs:label "leveraged-authorizations" ;
    rdfs:range oscal:LeveragedAuthorization ;
    skos:definition "A description of another authorized system from which this system inherits capabilities that satisfy security requirements." ;
    skos:inScheme oscal:oscal_ssp .

oscal:locations a owl:ObjectProperty ;
    rdfs:label "locations" ;
    rdfs:range oscal:Location ;
    skos:definition "A physical point of presence, which may be associated with people, organizations, or other concepts within the current or linked OSCAL document." ;
    skos:inScheme oscal:oscal_catalog .

oscal:mappings a owl:ObjectProperty ;
    rdfs:label "mappings" ;
    rdfs:range oscal:Mapping ;
    skos:definition "A collection of control mappings." ;
    skos:inScheme oscal:oscal_mapping .

oscal:maps a owl:ObjectProperty ;
    rdfs:label "maps" ;
    rdfs:range oscal:Map ;
    skos:definition "Mapping entries relating source items to target items." ;
    skos:inScheme oscal:oscal_mapping .

oscal:matching a owl:ObjectProperty ;
    rdfs:label "matching" ;
    rdfs:range oscal:ControlMatching ;
    skos:definition "Selecting a set of controls by matching their IDs with a wildcard pattern." ;
    skos:inScheme oscal:oscal_catalog .

oscal:member_of_organizations a owl:DatatypeProperty ;
    rdfs:label "member-of-organizations" ;
    rdfs:range xsd:string ;
    skos:definition "A reference to another party by UUID, typically an organization, that this subject is associated with." ;
    skos:inScheme oscal:oscal_catalog .

oscal:methods a owl:DatatypeProperty ;
    rdfs:label "methods" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:ObservationMethodEnum xsd:string ) ] ;
    skos:definition "Identifies how the observation was made. Recommended values are in ObservationMethodEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:mitigating_factors a owl:ObjectProperty ;
    rdfs:label "mitigating-factors" ;
    rdfs:range oscal:MitigatingFactor ;
    skos:definition "Describes existing mitigating factors that may affect the overall determination of the risk." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:parties a owl:ObjectProperty ;
    rdfs:label "parties" ;
    rdfs:range oscal:Party ;
    skos:definition "An organization or person, which may be associated with roles or other concepts within the current or linked OSCAL document." ;
    skos:inScheme oscal:oscal_catalog .

oscal:poam_items a owl:ObjectProperty ;
    rdfs:label "poam-items" ;
    rdfs:range oscal:PoamItem ;
    skos:definition "A collection of POA&M items." ;
    skos:inScheme oscal:oscal_poam .

oscal:port_ranges a owl:ObjectProperty ;
    rdfs:label "port-ranges" ;
    rdfs:range oscal:PortRange ;
    skos:definition "Where applicable, the transport layer protocol port range." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:provided a owl:ObjectProperty ;
    rdfs:label "provided" ;
    rdfs:range oscal:ProvidedControlImplementation ;
    skos:definition "Describes a capability which may be inherited by a leveraging system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:qualifiers a owl:ObjectProperty ;
    rdfs:label "qualifiers" ;
    rdfs:range oscal:QualifierItem ;
    skos:definition "Qualifier statements for a mapping entry." ;
    skos:inScheme oscal:oscal_mapping .

oscal:related_findings a owl:ObjectProperty ;
    rdfs:label "related-findings" ;
    rdfs:range oscal:RelatedFinding ;
    skos:definition "Relates a POA&M item to one or more findings." ;
    skos:inScheme oscal:oscal_poam .

oscal:related_responses a owl:ObjectProperty ;
    rdfs:label "related-responses" ;
    rdfs:range oscal:RiskResponseReference ;
    skos:definition "Identifies an individual risk response that this log entry is for." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:relevant_evidence a owl:ObjectProperty ;
    rdfs:label "relevant-evidence" ;
    rdfs:range oscal:RelevantEvidence ;
    skos:definition "Links the observation to relevant evidence." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:remediations a owl:ObjectProperty ;
    rdfs:label "remediations" ;
    rdfs:range oscal:Response ;
    skos:definition "Describes either recommended or actual responses to a risk." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:removes a owl:ObjectProperty ;
    rdfs:label "removes" ;
    rdfs:range oscal:Removal ;
    skos:definition "Specifies objects to be removed from a control in resolution." ;
    skos:inScheme oscal:oscal_profile .

oscal:required_assets a owl:ObjectProperty ;
    rdfs:label "required-assets" ;
    rdfs:range oscal:RequiredAsset ;
    skos:definition "Identifies an asset required to achieve remediation." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:resources a owl:ObjectProperty ;
    rdfs:label "resources" ;
    rdfs:range oscal:Resource ;
    skos:definition "A resource associated with content in the containing document instance. A resource may be directly included in the document using base64 encoding or may point to one or more equivalent internet resources." ;
    skos:inScheme oscal:oscal_catalog .

oscal:responsibilities a owl:ObjectProperty ;
    rdfs:label "responsibilities" ;
    rdfs:range oscal:ControlResponsibility ;
    skos:definition "Describes a control implementation responsibility imposed on a leveraging system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:results a owl:ObjectProperty ;
    rdfs:label "results" ;
    rdfs:range oscal:Result ;
    skos:definition "A collection of assessment results." ;
    skos:inScheme oscal:oscal_assessment_results .

oscal:revisions a owl:ObjectProperty ;
    rdfs:label "revisions" ;
    rdfs:range oscal:Revision ;
    skos:definition "An entry in a sequential list of revisions to the containing document, expected to be in reverse chronological order (i.e. latest first)." ;
    skos:inScheme oscal:oscal_catalog .

oscal:rlinks a owl:ObjectProperty ;
    rdfs:label "rlinks" ;
    rdfs:range oscal:ResourceLink ;
    skos:definition "A URL-based pointer to an external resource with an optional hash for verification and change detection." ;
    skos:inScheme oscal:oscal_catalog .

oscal:role_ids a owl:DatatypeProperty ;
    rdfs:label "role-ids" ;
    rdfs:range xsd:string ;
    skos:definition "Role identifiers associated with the user." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:roles a owl:ObjectProperty ;
    rdfs:label "roles" ;
    rdfs:range oscal:Role ;
    skos:definition "Defines a function, which might be assigned to a party in a specific situation." ;
    skos:inScheme oscal:oscal_catalog .

oscal:satisfied a owl:ObjectProperty ;
    rdfs:label "satisfied" ;
    rdfs:range oscal:SatisfiedControlImplementation ;
    skos:definition "Describes how this system satisfies a responsibility imposed by a leveraged system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:statement_ids a owl:DatatypeProperty ;
    rdfs:label "statement-ids" ;
    rdfs:range xsd:string ;
    skos:definition "Statement IDs for control selection." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:steps a owl:ObjectProperty ;
    rdfs:label "steps" ;
    rdfs:range oscal:Step ;
    skos:definition "A collection of steps in an activity." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:system_ids a owl:ObjectProperty ;
    rdfs:label "system-ids" ;
    rdfs:range oscal:SystemId ;
    skos:definition "Unique identifiers for the system." ;
    skos:inScheme oscal:oscal_ssp .

oscal:targets a owl:ObjectProperty ;
    rdfs:label "targets" ;
    rdfs:range oscal:MappingItem ;
    skos:definition "Target subjects participating in a mapping entry." ;
    skos:inScheme oscal:oscal_mapping .

oscal:tests a owl:ObjectProperty ;
    rdfs:label "tests" ;
    rdfs:range oscal:ConstraintTest ;
    skos:definition "A test expression which is expected to be evaluated by a tool." ;
    skos:inScheme oscal:oscal_catalog .

oscal:threat_ids a owl:ObjectProperty ;
    rdfs:label "threat-ids" ;
    rdfs:range oscal:ThreatId ;
    skos:definition "The referenced threat identifiers." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:types a owl:DatatypeProperty ;
    rdfs:label "types" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( oscal:ObservationTypeEnum xsd:string ) ] ;
    skos:definition "Identifies the nature of the observation. Recommended values are in ObservationTypeEnum; other values are permitted (OSCAL allow-other=\"yes\")." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:unmapped_controls a owl:ObjectProperty ;
    rdfs:label "unmapped-controls" ;
    rdfs:range oscal:SelectControlById ;
    skos:definition "Controls that remain unmapped." ;
    skos:inScheme oscal:oscal_mapping .

oscal:urls a owl:DatatypeProperty ;
    rdfs:label "urls" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The uniform resource locator (URL) for a web site or other resource associated with the location." ;
    skos:inScheme oscal:oscal_catalog .

oscal:uses_components a owl:ObjectProperty ;
    rdfs:label "uses-components" ;
    rdfs:range oscal:UsesComponent ;
    skos:definition "The set of components used by the assessment platform." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:with_ids a owl:DatatypeProperty ;
    rdfs:label "with-ids" ;
    rdfs:range xsd:string ;
    skos:definition "Selecting a control by its ID given as a literal." ;
    skos:inScheme oscal:oscal_catalog .

oscal:ActionTypeEnum a owl:Class ;
    rdfs:label "ActionTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/ActionTypeEnum#approval> <https://w3id.org/lmodel/oscal/ActionTypeEnum#request-changes> ) ;
    skos:definition "Allowed OSCAL action type values." ;
    skos:inScheme oscal:oscal_catalog ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/ActionTypeEnum#approval>,
        <https://w3id.org/lmodel/oscal/ActionTypeEnum#request-changes> ;
    oscal:oscal_allowed_values "oscal-metadata-action-type-values" .

oscal:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:steps ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:uuid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:Step ;
            owl:onProperty oscal:steps ],
        [ a owl:Restriction ;
            owl:allValuesFrom oscal:ReviewedControls ;
            owl:onProperty oscal:related_controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oscal:related_controls ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oscal:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oscal:related_controls ],
        oscal:HasResponsibleRoles,
        oscal:OscalCommon ;
    skos:definition "Identifies an assessment or related process that can be performed. In the assessment plan, this is an intended activity." ;
    skos:inScheme oscal:oscal_assessment_plan .

oscal:AddressTypeEnum a owl:Class ;
    rdfs:label "AddressTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/AddressTypeEnum#home> <https://w3id.org/lmodel/oscal/AddressTypeEnum#work> ) ;
    skos:definition """Curated address type values. Other values are permitted (OSCAL allow-other="yes").
""" ;
    skos:inScheme oscal:oscal_catalog ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/AddressTypeEnum#home>,
        <https://w3id.org/lmodel/oscal/AddressTypeEnum#work> ;
    oscal:allow_any true ;
    oscal:oscal_allowed_values "oscal-metadata-address-location-type-values" .

oscal:AllowsAuthenticatedScanEnum a owl:Class ;
    rdfs:label "AllowsAuthenticatedScanEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/oscal/AllowsAuthenticatedScanEnum#yes> <https://w3id.org/lmodel/oscal/AllowsAuthenticatedScanEnum#no> ) ;
    skos:definition "Values for allows-authenticated-scan property in SSP component and inventory contexts." ;
    skos:inScheme oscal:oscal_ssp ;
    linkml:permissible_values <https://w3id.org/lmodel/oscal/AllowsAuthenticatedScanEnum#no>,
